async def oden_core(oden_brain, oden_policy, eff_manager, cot):
    """Core logic for Oden: monitor system, detect anomalies, and take actions."""
    global dynamics, consciousness
    start_prometheus_server()
    dynamics = OdenDynamics()  # Ensure dynamics is initialized
    consciousness = ConsciousnessModule(oden_brain, oden_policy, cot)  # Initialize consciousness
    predictive_model = PredictiveModel()  # For proactive predictions
    STATE.logger.log_event("INFO", "Oden core activated")

    while STATE.active:
        try:
            # Gather current system metrics
            metrics = await gather_metrics()
            STATE.metrics_history.append(metrics)
            update_prometheus_gauges(metrics, 0.0)  # Update basic metrics
            log_gpu_utilization()

            # Predict anomaly and assess system state
            anomaly_score, class_score, cluster_distance, uncertainty = oden_brain.predict(metrics)
            STATE.anomaly_history.append(anomaly_score)
            update_prometheus_gauges(metrics, anomaly_score)
            state = compute_state(metrics, anomaly_score, cluster_distance)

            # Train brain incrementally
            oden_brain.train(metrics)
            dynamics.train()  # Train dynamics model if enough data

            # Assess anomaly and select action
            assessment = cot.assess_anomaly(metrics, anomaly_score, cluster_distance)
            thought = express_thought("anomaly_detected", {"score": anomaly_score})
            STATE.logger.log_event("INFO", thought)

            if anomaly_score > CONFIG.anomaly_threshold or assessment["severity"] == "high":
                action = cot.select_action(state, assessment)
                thought = express_thought("action_selected", {"action": action})
                STATE.logger.log_event("INFO", thought)

                # Execute action and evaluate
                pre_metrics = metrics.copy()
                reward = await execute_action(action, {"bad_ips": list(STATE.bad_ips)}, eff_manager)
                post_metrics = await gather_metrics()
                evaluation = cot.evaluate_response(action, reward, pre_metrics, post_metrics)
                thought = express_thought("action_executed", {"action": action, "reward": reward})
                STATE.logger.log_event("INFO", thought)

                # Update policy and dynamics
                next_state = compute_state(post_metrics, oden_brain.predict(post_metrics)[0], cluster_distance)
                oden_policy.learn(state, action, reward, next_state)
                if oden_brain.scaler_fitted:
                    normalized_post = oden_brain.scaler.transform(post_metrics.reshape(1, -1))[0]
                    dynamics.remember(STATE.metrics_history, action, normalized_post)

                # Notify if critical
                if reward < 0 or evaluation["success"] is False:
                    await send_notification({"action": action, "reward": reward, "metrics": post_metrics.tolist()})

            # Proactive step based on prediction
            history = np.array(list(STATE.metrics_history)[-CONFIG.metrics_window:] if len(STATE.metrics_history) >= CONFIG.metrics_window else np.zeros((CONFIG.metrics_window, 13)))
            predictive_model.train(history)
            predicted_metrics = predictive_model.predict(history)
            proactive_action = cot.proactive_step(metrics, predicted_metrics)
            if proactive_action:
                reward = await execute_action(proactive_action, {}, eff_manager)
                thought = express_thought("action_executed", {"action": proactive_action, "reward": reward})
                STATE.logger.log_event("INFO", thought)

            # Detailed status periodically
            if random.random() < 0.1:
                thought = express_thought("detailed_status", {
                    "cpu": metrics[0], "mem": metrics[1], "disk": metrics[2], "net_sent": metrics[3],
                    "net_recv": metrics[4], "processes": metrics[5], "connections": metrics[6],
                    "bad_conns": metrics[7], "max_cpu": metrics[8], "max_mem": metrics[9],
                    "disk_io": metrics[10], "latency": metrics[11], "user_logins": metrics[12]
                })
                STATE.logger.log_event("INFO", thought)

            await asyncio.sleep(CONFIG.check_interval)

        except Exception as e:
            STATE.error_count += 1
            STATE.logger.log_event("ERROR", "Oden core iteration failed", {"error": str(e), "traceback": traceback.format_exc()})
            thought = express_thought("error_detected", {"error": str(e), "component": "oden_core", "traceback": traceback.format_exc()})
            print(thought)
            await asyncio.sleep(CONFIG.check_interval)

async def run_oden() -> None:
