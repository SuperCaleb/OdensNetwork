class SignatureDetector:
    def __init__(self, signature_file: str) -> None:
        try:
            self.signatures = self.load_signatures(signature_file)
            self.metrics_map = {
                "cpu": 0, "mem": 1, "disk": 2, "net_sent": 3, "net_recv": 4, "processes": 5,
                "connections": 6, "bad_conns": 7, "max_cpu": 8, "max_mem": 9, "disk_io": 10,
                "latency": 11, "user_logins": 12
            }
        except Exception as e:
            STATE.logger.log_event("ERROR", "SignatureDetector initialization failed", {"error": str(e), "traceback": traceback.format_exc()})
            self.signatures = []

    def load_signatures(self, file_path: str) -> List[Dict[str, Any]]:
        try:
            with open(file_path, "r") as f:
                return json.load(f)
        except Exception as e:
            STATE.logger.log_event("ERROR", f"Failed to load signatures: {str(e)}", {"traceback": traceback.format_exc()})
            return []

    def check_metrics(self, metrics: np.ndarray) -> List[str]:
        try:
            detected = []
            for sig in self.signatures:
                if self.match_signature(sig, metrics):
                    detected.append(sig["name"])
            return detected
        except Exception as e:
            STATE.logger.log_event("ERROR", "Signature check failed", {"error": str(e), "traceback": traceback.format_exc()})
            return []

    def match_signature(self, sig: Dict[str, Any], metrics: np.ndarray) -> bool:
        try:
            for key, threshold in sig["conditions"].items():
                if key in self.metrics_map:
                    index = self.metrics_map[key]
                else:
                    index = int(key)
                if metrics[index] > threshold:
                    return True
            return False
        except Exception as e:
            STATE.logger.log_event("ERROR", "Signature matching failed", {"error": str(e), "traceback": traceback.format_exc()})
            return False

# --- Holographic Memory ---
class HolographicMemory:
    def __init__(self, size: int = CONFIG.memory_size, dim: int = 32) -> None:
        try:
            self.memory = np.zeros((size, dim), dtype=np.float32)
            self.index = 0
            self.size = size
            self.dim = dim
        except Exception as e:
            STATE.logger.log_event("ERROR", "HolographicMemory initialization failed", {"error": str(e), "traceback": traceback.format_exc()})

    def add(self, vector: np.ndarray) -> None:
        try:
            if self.index < self.size:
                norm_vector = vector / (np.linalg.norm(vector) + 1e-8)
                self.memory[self.index] = norm_vector
                self.index += 1
        except Exception as e:
            STATE.logger.log_event("ERROR", "HolographicMemory add failed", {"error": str(e), "traceback": traceback.format_exc()})

    def query(self, partial_vector: np.ndarray, top_k: int = 5) -> Tuple[np.ndarray, np.ndarray]:
        try:
            if self.index == 0:
                return np.array([]), np.array([])
            norm_partial = partial_vector / (np.linalg.norm(partial_vector) + 1e-8)
            similarities = np.dot(self.memory[:self.index], norm_partial)
            indices = np.argsort(similarities)[-top_k:][::-1]
            return indices, similarities[indices]
        except Exception as e:
            STATE.logger.log_event("ERROR", "HolographicMemory query failed", {"error": str(e), "traceback": traceback.format_exc()})
            return np.array([]), np.array([])

