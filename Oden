# --- Main Execution ---
async def run_oden() -> None:
    global oden_brain, oden_policy, eff_manager, dynamics, cot, consciousness
    oden_brain = OdenBrain()
    oden_policy = OdenPolicy()
    eff_manager = EffectivenessManager(CONFIG.effectiveness_file, CONFIG.backup_dir)
    dynamics = OdenDynamics()
    cot = OdenCoT(oden_brain, oden_policy, STATE.logger.logger, dynamics)

    loop = asyncio.get_event_loop()
    user_queue = asyncio.Queue()
    thread = threading.Thread(target=read_stdin, args=(loop, user_queue), daemon=True)
    thread.start()

    loop.create_task(handle_user_input(user_queue))
    await asyncio.gather(
        oden_core(oden_brain, oden_policy, eff_manager, cot),
        refresh_threat_intel(),
        health_check(oden_brain, oden_policy, eff_manager),
        STATE.logger.report_metrics()
    )

def signal_handler(sig, frame) -> None:
    STATE.active = False
    eff_manager.save()

if __name__ == "__main__":
    oden_brain = OdenBrain()
    oden_policy = OdenPolicy()
    eff_manager = EffectivenessManager(CONFIG.effectiveness_file, CONFIG.backup_dir)

    signal.signal(signal.SIGINT, signal_handler)
    signal.signal(signal.SIGTERM, signal_handler)

    threading.Thread(target=watchdog, daemon=True).start()
    analyze_system()
    for i in range(10):
        print(f"{i * 10}% Process completed...")
        time.sleep(0.1)
    print("O_security Online:")

    try:
        asyncio.run(run_oden())
    except Exception as e:
        STATE.logger.log_event("CRITICAL", "Oden crashed", {"error": str(e), "traceback": traceback.format_exc()})
        STATE.active = False
