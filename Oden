        try:
            lr_schedule = tf.keras.optimizers.schedules.ExponentialDecay(
                initial_learning_rate=CONFIG.learning_rate,
                decay_steps=1000,
                decay_rate=0.96,
                staircase=True)
            self.optimizer = tf.keras.optimizers.Adam(learning_rate=lr_schedule)
            self.model = self._build_model()
            self.holo_memory = HolographicMemory()
            self.memory = deque(maxlen=CONFIG.memory_size)
            self.epsilon = CONFIG.epsilon_initial
            self.scaler = SCALER
            self.scaler_fitted = False
            self.mse_threshold = None
            self.cluster_model = None
            self.mse_mean = 0.0
            self.mse_var = 0.0
            self.mse_count = 0
            self.batch_size = 32
        except Exception as e:
            STATE.logger.log_event("ERROR", "OdenBrain initialization failed", {"error": str(e), "traceback": traceback.format_exc()})
            raise

    def _build_model(self) -> tf.keras.Model:
        try:
            strategy = tf.distribute.MirroredStrategy() if tf.config.list_physical_devices('GPU') else None
            def build():
                inputs = Input(shape=(CONFIG.metrics_window, 13))
                inputs_transposed = layers.Lambda(lambda x: tf.transpose(x, perm=[0, 2, 1]))(inputs)
                fft_transposed = layers.Lambda(lambda x: tf.signal.fft(tf.cast(x, tf.complex64)))(inputs_transposed)
                fft = layers.Lambda(lambda x: tf.transpose(x, perm=[0, 2, 1]))(fft_transposed)
                fft_real = layers.Lambda(lambda x: tf.math.real(x))(fft)
                fft_imag = layers.Lambda(lambda x: tf.math.imag(x))(fft)
                fft_features = layers.Concatenate(axis=-1)([fft_real, fft_imag])
                combined_inputs = layers.Concatenate(axis=-1)([inputs, fft_features])
                conv1 = layers.Conv1D(32, 3, dilation_rate=1, padding='same', activation='relu')(combined_inputs)
                conv2 = layers.Conv1D(32, 3, dilation_rate=2, padding='same', activation='relu')(combined_inputs)
                conv3 = layers.Conv1D(32, 3, dilation_rate=4, padding='same', activation='relu')(combined_inputs)
                conv_concat = layers.Concatenate()([conv1, conv2, conv3])
                x = layers.Dense(64)(conv_concat)
                x = PositionalEncoding(CONFIG.metrics_window, 64)(x)
                x = TransformerEncoderLayer(d_model=64, num_heads=4, ff_dim=128)(x)
                x = layers.LSTM(32, return_sequences=True, dropout=0.2, recurrent_dropout=0.2)(x)
                recon_out = layers.TimeDistributed(layers.Dense(13))(x)
                pooled = layers.GlobalAveragePooling1D()(x)
                class_out = layers.Dense(1, activation="sigmoid", name="anomaly_score")(pooled)
                model = Model(inputs, [recon_out, class_out, pooled])
                model.compile(
                    optimizer=self.optimizer,
                    loss=["mse", "binary_crossentropy", None],
                    loss_weights=[0.6, 0.4, 0.0]
                )
                return model

            if strategy:
                with strategy.scope():
                    return build()
            return build()
        except Exception as e:
            STATE.logger.log_event("ERROR", "Model building failed", {"error": str(e), "traceback": traceback.format_exc()})
            raise

    def predict(self, metrics: np.ndarray, use_history: bool = True, mc_runs: int = 10) -> Tuple[float, float, float, float]:
        try:
            padded = self._prepare_metrics(metrics, use_history)
            if self.scaler_fitted:
                normalized = self.scaler.transform(padded).astype(np.float32)
            else:
                normalized = padded.astype(np.float32)
                STATE.logger.log_event("DEBUG", "Scaler not fitted; using raw metrics")
            batch = tf.convert_to_tensor(normalized[None, :], dtype=tf.float32)
            recon_list = []
            class_list = []
            pooled_list = []
            for _ in range(mc_runs):
                recon, class_prob, pooled = self.model(batch, training=True)
                recon_list.append(recon)
                class_list.append(class_prob)
                pooled_list.append(pooled)
            recon_avg = tf.reduce_mean(tf.stack(recon_list), axis=0)
            class_avg = tf.reduce_mean(tf.stack(class_list), axis=0)
            pooled_avg = tf.reduce_mean(tf.stack(pooled_list), axis=0)
            mse = tf.reduce_mean(tf.square(batch - recon_avg), axis=[1, 2]).numpy()[0]
            anomaly_score = self._scale_mse(mse)
            class_score = class_avg[0][0].numpy()
            cluster_distance = self._compute_cluster_distance(normalized) if self.cluster_model else 0.0
            mse_runs = tf.stack([tf.reduce_mean(tf.square(batch - r), axis=[1,2]) for r in recon_list], axis=0)
            uncertainty = tf.math.reduce_std(mse_runs, axis=0).numpy()[0]
            if self.holo_memory.index > 0:
                indices, similarities = self.holo_memory.query(pooled_avg[0], top_k=5)
                memory_anomaly = 1 - np.mean(np.clip(similarities, 0, 1)) if len(similarities) > 0 else 1.0
                anomaly_score = max(anomaly_score, memory_anomaly)
            if 'consciousness' in globals():
                consciousness.update_self_state(metrics)
            return anomaly_score, class_score, cluster_distance, uncertainty
        except Exception as e:
            STATE.logger.log_event("ERROR", "Prediction failed", {"error": str(e), "traceback": traceback.format_exc()})
            return 0.0, 0.0, 0.0, 0.0

    def _compute_cluster_distance(self, normalized: np.ndarray) -> float:
        try:
            centers = self.cluster_model.cluster_centers_
            distances = np.linalg.norm(centers - normalized[-1], axis=1)
            return np.min(distances)
        except Exception as e:
            STATE.logger.log_event("ERROR", "Cluster distance computation failed", {"error": str(e), "traceback": traceback.format_exc()})
            return 0.0

    def train(self, metrics: np.ndarray, label: Optional[float] = None, batch_train: bool = False) -> None:
        try:
            padded = self._prepare_metrics(metrics, True)
            if not self.scaler_fitted:
                self.scaler.fit(padded)
                self.scaler_fitted = True
            else:
                self.scaler.partial_fit(padded)
            normalized = self.scaler.transform(padded).astype(np.float32)
            self.memory.append((normalized, label))

            if len(self.memory) >= self.batch_size:
                batch_data = random.sample(self.memory, self.batch_size)
                X = np.array([d[0] for d in batch_data])
                y_recon = X
                y_class = np.array([d[1] if d[1] is not None else self.predict(d[0])[1] for d in batch_data]).reshape(-1, 1)
                y_pooled = np.zeros((self.batch_size, 32))
                loss = self.model.train_on_batch(X, [y_recon, y_class, y_pooled])
                STATE.logger.log_event("INFO", f"Online training completed, loss: {loss}")

            if len(self.memory) >= 50 and (self.cluster_model is None or batch_train):
                data = np.array([m[0][-1] for m in self.memory])
                self.cluster_model = KMeans(n_clusters=5).fit(data)
                STATE.logger.log_event("INFO", "Clustering model updated")

            mse = tf.reduce_mean(tf.square(normalized - self.model(normalized[None, :])[0])).numpy()
            self._update_mse_stats(mse)
        except Exception as e:
            STATE.logger.log_event("ERROR", "Training failed", {"error": str(e), "traceback": traceback.format_exc()})

    def _update_mse_stats(self, mse: float) -> None:
        try:
            self.mse_count += 1
            delta = mse - self.mse_mean
            self.mse_mean += delta / self.mse_count
            self.mse_var += delta * (mse - self.mse_mean)
            self.mse_threshold = self.mse_mean + 3 * np.sqrt(self.mse_var / max(1, self.mse_count - 1)) if self.mse_count > 1 else mse * 10
        except Exception as e:
            STATE.logger.log_event("ERROR", "MSE stats update failed", {"error": str(e), "traceback": traceback.format_exc()})

    def _scale_mse(self, mse: float) -> float:
        try:
            if self.mse_threshold is None:
                return min(mse * 100, 1.0)
            return min(mse / self.mse_threshold, 1.0)
        except Exception as e:
            STATE.logger.log_event("ERROR", "MSE scaling failed", {"error": str(e), "traceback": traceback.format_exc()})
            return 0.0

    def _prepare_metrics(self, metrics: np.ndarray, use_history: bool) -> np.ndarray:
        try:
            if use_history:
                STATE.metrics_history.append(metrics)
                history = list(STATE.metrics_history)
                if len(history) < CONFIG.metrics_window:
                    padded = np.zeros((CONFIG.metrics_window, 13), dtype=np.float32)
                    padded[-len(history):] = history
                else:
                    padded = np.array(history[-CONFIG.metrics_window:], dtype=np.float32)
            else:
                padded = metrics.astype(np.float32)
            return padded
        except Exception as e:
            STATE.logger.log_event("ERROR", "Metrics preparation failed", {"error": str(e), "traceback": traceback.format_exc()})
            return np.zeros((CONFIG.metrics_window, 13), dtype=np.float32)

    def decay_epsilon(self) -> None:
        try:
            self.epsilon = max(CONFIG.epsilon_min, self.epsilon * CONFIG.epsilon_decay)
        except Exception as e:
            STATE.logger.log_event("ERROR", "Epsilon decay failed", {"error": str(e), "traceback": traceback.format_exc()})

    def validate(self, validation_data: Optional[np.ndarray] = None) -> bool:
        try:
            if validation_data is None and len(STATE.metrics_history) >= CONFIG.metrics_window:
                validation_data = np.array(list(STATE.metrics_history)[-CONFIG.metrics_window:], dtype=np.float32)
            elif validation_data is None:
                validation_data = np.random.rand(CONFIG.metrics_window, 13).astype(np.float32)
            if self.scaler_fitted:
                validation_data = self.scaler.transform(validation_data).astype(np.float32)
            batch = tf.convert_to_tensor(validation_data[None, :], dtype=tf.float32)
            recon, _, _ = self.model.predict(batch, verbose=0)
            mse = tf.reduce_mean(tf.square(batch - recon)).numpy()
            threshold = self.mse_threshold or 0.1
            return mse < threshold
        except Exception as e:
            STATE.logger.log_event("ERROR", "Model validation failed", {"error": str(e), "traceback": traceback.format_exc()})
            return False

# --- Prioritized Replay Buffer ---
class PrioritizedReplayBuffer:
    def __init__(self, capacity: int):
        try:
            self.capacity = capacity
            self.buffer = []
            self.priorities = np.zeros((capacity,), dtype=np.float32)
            self.pos = 0
        except Exception as e:
            STATE.logger.log_event("ERROR", "PrioritizedReplayBuffer initialization failed", {"error": str(e), "traceback": traceback.format_exc()})

    def add(self, experience: Tuple, error: float):
        try:
            max_priority = self.priorities.max() if self.buffer else 1.0
            if len(self.buffer) < self.capacity:
                self.buffer.append(experience)
            else:
                self.buffer[self.pos] = experience
            self.priorities[self.pos] = max(max_priority, error)
            self.pos = (self.pos + 1) % self.capacity
        except Exception as e:
            STATE.logger.log_event("ERROR", "Replay buffer add failed", {"error": str(e), "traceback": traceback.format_exc()})

    def sample(self, batch_size: int, alpha: float = 0.6):
        try:
            if len(self.buffer) == self.capacity:
                prios = self.priorities
            else:
                prios = self.priorities[:self.pos]
            probs = prios ** alpha
            probs /= probs.sum()
            indices = np.random.choice(len(self.buffer), batch_size, p=probs)
            samples = [self.buffer[idx] for idx in indices]
            return samples, indices
        except Exception as e:
            STATE.logger.log_event("ERROR", "Replay buffer sample failed", {"error": str(e), "traceback": traceback.format_exc()})
            return [], []

    def update(self, indices: List[int], errors: List[float]):
        try:
            for idx, error in zip(indices, errors):
                self.priorities[idx] = error
        except Exception as e:
            STATE.logger.log_event("ERROR", "Replay buffer update failed", {"error": str(e), "traceback": traceback.format_exc()})

# --- Oden Policy ---
class OdenPolicy:
    def __init__(self) -> None:
        try:
            self.gamma = 0.97
            self.epsilon = CONFIG.epsilon_initial
            self.epsilon_min = CONFIG.epsilon_min
            self.epsilon_decay = CONFIG.epsilon_decay
            self.learning_rate = CONFIG.learning_rate
            self.batch_size = 64
            self.target_update_freq = 25
            self.q_model = self._build_model()
            self.target_model = self._build_model()
            self.update_target_model()
            self.steps = 0
            self.memory = PrioritizedReplayBuffer(capacity=10000)
            self.beta = 0.4
        except Exception as e:
            STATE.logger.log_event("ERROR", "OdenPolicy initialization failed", {"error": str(e), "traceback": traceback.format_exc()})
            raise

    def _build_model(self) -> tf.keras.Model:
        try:
            state_input = Input(shape=(5,))
            dense1 = layers.Dense(256, activation='relu')(state_input)
            dense2 = layers.Dense(256, activation='relu')(dense1)
            value = layers.Dense(1)(dense2)
            advantage = layers.Dense(len(ACTIONS))(dense2)
            def combine_streams(x):
                v, a = x
                return v + (a - tf.reduce_mean(a, axis=1, keepdims=True))
            q_values = layers.Lambda(combine_streams)([value, advantage])
            model = Model(state_input, q_values)
            model.compile(optimizer=tf.keras.optimizers.Adam(learning_rate=self.learning_rate), loss='mse')
            return model
        except Exception as e:
            STATE.logger.log_event("ERROR", "Policy model building failed", {"error": str(e), "traceback": traceback.format_exc()})
            raise

    def update_target_model(self) -> None:
        try:
            self.target_model.set_weights(self.q_model.get_weights())
        except Exception as e:
            STATE.logger.log_event("ERROR", "Target model update failed", {"error": str(e), "traceback": traceback.format_exc()})

    def choose_action(self, state: Tuple[int, int, int, int, int]) -> str:
        try:
            if random.random() < self.epsilon:
                return random.choice(ACTIONS)
            q_values = self.q_model.predict(np.array([state]), verbose=0)[0]
            if 'consciousness' in globals():
                valence = consciousness.emotional_valence
                q_values = q_values * (1 + valence * 0.2)
            return ACTIONS[np.argmax(q_values)]
        except Exception as e:
            STATE.logger.log_event("ERROR", "Action selection failed", {"error": str(e), "traceback": traceback.format_exc()})
            return random.choice(ACTIONS)

    def learn(self, state: Tuple[int, int, int, int, int], action: str, reward: float,
              next_state: Tuple[int, int, int, int, int]) -> None:
        try:
            current_q = self.q_model.predict(np.array([state]), verbose=0)[0][ACTIONS.index(action)]
            next_q = np.max(self.target_model.predict(np.array([next_state]), verbose=0)[0])
            td_target = reward + self.gamma * next_q
            td_error = abs(td_target - current_q)
            self.memory.add((state, action, reward, next_state, False), td_error)
            self.replay()
        except Exception as e:
            STATE.logger.log_event("ERROR", "Policy learning failed", {"error": str(e), "traceback": traceback.format_exc()})

    def replay(self) -> None:
        try:
            if len(self.memory.buffer) < self.batch_size:
                return
            minibatch, indices = self.memory.sample(self.batch_size)
            states = np.array([t[0] for t in minibatch])
            actions = [ACTIONS.index(t[1]) for t in minibatch]
            rewards = [t[2] for t in minibatch]
            next_states = np.array([t[3] for t in minibatch])
            dones = [t[4] for t in minibatch]

            targets = self.q_model.predict(states, verbose=0)
            next_q_values = self.target_model.predict(next_states, verbose=0)
            new_td_errors = []
            for i in range(self.batch_size):
                if dones[i]:
                    targets[i][actions[i]] = rewards[i]
                else:
                    targets[i][actions[i]] = rewards[i] + self.gamma * np.max(next_q_values[i])
                new_td_errors.append(abs(targets[i][actions[i]] - self.q_model.predict(np.array([states[i]]), verbose=0)[0][actions[i]]))
            self.q_model.fit(states, targets, epochs=1, verbose=0)
            self.memory.update(indices, new_td_errors)
            self.epsilon = max(self.epsilon_min, self.epsilon * self.epsilon_decay)
            self.steps += 1
            if self.steps % self.target_update_freq == 0:
                self.update_target_model()
        except Exception as e:
            STATE.logger.log_event("ERROR", "Replay failed", {"error": str(e), "traceback": traceback.format_exc()})

    def compute_stability_reward(self) -> float:
        try:
            recent_scores = list(STATE.anomaly_history)[-10:]
            avg_score = np.mean(recent_scores) if recent_scores else 0.0
            std_score = np.std(recent_scores) if recent_scores else 0.0
            return -avg_score - 0.5 * std_score
        except Exception as e:
            STATE.logger.log_event("ERROR", "Stability reward computation failed", {"error": str(e), "traceback": traceback.format_exc()})
            return 0.0

# --- Dynamics Model ---
class OdenDynamics:
    def __init__(self) -> None:
        try:
            self.model = self._build_model()
            self.memory = deque(maxlen=10000)
        except Exception as e:
            STATE.logger.log_event("ERROR", "OdenDynamics initialization failed", {"error": str(e), "traceback": traceback.format_exc()})
            raise

    def _build_model(self) -> tf.keras.Model:
        try:
            inputs_states = Input(shape=(3, 13))
            attn = layers.MultiHeadAttention(num_heads=2, key_dim=16)(inputs_states, inputs_states)
            attn = layers.Dropout(0.2)(attn)
            lstm_out = layers.LSTM(64)(attn)
            inputs_action = Input(shape=(len(ACTIONS),))
            combined = layers.Concatenate()([lstm_out, inputs_action])
            x = layers.Dense(128, activation='relu')(combined)
            x = layers.Dropout(0.2)(x)
            outputs = layers.Dense(13)(x)
            model = Model(inputs=[inputs_states, inputs_action], outputs=outputs)
            model.compile(optimizer='adam', loss='mse')
            return model
        except Exception as e:
            STATE.logger.log_event("ERROR", "Dynamics model building failed", {"error": str(e), "traceback": traceback.format_exc()})
            raise

    def remember(self, sequence_metrics: deque, action: str, normalized_next_metrics: np.ndarray) -> None:
        try:
            if len(sequence_metrics) < 3:
                sequence_raw = list(sequence_metrics)
                while len(sequence_raw) < 3:
                    sequence_raw.insert(0, sequence_raw[0] if sequence_raw else np.zeros(13))
                sequence_raw = sequence_raw[-3:]
            else:
                sequence_raw = list(sequence_metrics)[-3:]
            normalized_sequence = oden_brain.scaler.transform(np.array(sequence_raw))
            one_hot_action = np.zeros(len(ACTIONS))
            one_hot_action[ACTIONS.index(action)] = 1
            self.memory.append((normalized_sequence, one_hot_action, normalized_next_metrics))
        except Exception as e:
            STATE.logger.log_event("ERROR", "Dynamics memory storage failed", {"error": str(e), "traceback": traceback.format_exc()})

    def train(self) -> None:
        try:
            if len(self.memory) < 1000:
                return
            batch = random.sample(self.memory, 256)
            X_states = np.array([d[0] for d in batch])
            X_actions = np.array([d[1] for d in batch])
            Y = np.array([d[2] for d in batch])
            self.model.fit([X_states, X_actions], Y, epochs=1, verbose=0)
        except Exception as e:
            STATE.logger.log_event("ERROR", "Dynamics training failed", {"error": str(e), "traceback": traceback.format_exc()})

# --- Reward Estimation ---
def estimate_reward(action: str, current_metrics: np.ndarray, next_metrics: np.ndarray) -> float:
    try:
        stability_bonus = oden_policy.compute_stability_reward()
        if action == "Terminate":
            return 1.5 if next_metrics[0] < 80 and next_metrics[8] < 50 else -0.5 + stability_bonus
        elif action == "Encrypt":
            return 1.2 + stability_bonus
        elif action == "Transmit":
            return 0.7 + stability_bonus
        elif action == "Delete":
            return 1.0 if next_metrics[0] < current_metrics[0] else 0.0 + stability_bonus
        elif action == "Investigate":
            return 0.5 + stability_bonus
        elif action == "Block":
            return 1.5 if next_metrics[7] == 0 else 0.0 + stability_bonus
        elif action == "Quarantine":
            return 0.8 + stability_bonus
        elif action == "Isolate":
            return 1.0 + stability_bonus
        elif action == "Repair":
            return 1.2 if next_metrics[0] < current_metrics[0] else 0.0 + stability_bonus
        elif action == "Reinforce":
            return 0.8 + stability_bonus
        return stability_bonus
    except Exception as e:
        STATE.logger.log_event("ERROR", "Reward estimation failed", {"error": str(e), "traceback": traceback.format_exc()})
        return 0.0

# --- Predictive Model ---
# FIX: Converted to Functional API to correctly pass query and value to MultiHeadAttention.
class PredictiveModel:
    def __init__(self) -> None:
        try:
            self.model = self.build_model()
            self.model.compile(optimizer="adam", loss="mse")
            self.last_train_time = 0
            self.train_interval = 20
        except Exception as e:
            STATE.logger.log_event("ERROR", "PredictiveModel initialization failed", {"error": str(e), "traceback": traceback.format_exc()})
            raise

    def build_model(self) -> tf.keras.Model:
        inputs = Input(shape=(CONFIG.metrics_window, 13))
        x = layers.Bidirectional(layers.LSTM(64, return_sequences=True, dropout=0.2))(inputs)
        # Use Functional API to call MultiHeadAttention with both query and value as x.
        attn_output = layers.MultiHeadAttention(num_heads=2, key_dim=16)(x, x)
        x = layers.GlobalAveragePooling1D()(attn_output)
        outputs = layers.Dense(13)(x)
        return Model(inputs, outputs)

    def train(self, full_history: np.ndarray, force: bool = False, num_sequences: int = 100) -> None:
        try:
            current_time = time.time()
            if force or (current_time - self.last_train_time > self.train_interval * CONFIG.check_interval):
                if len(full_history) > CONFIG.metrics_window:
                    num_available = len(full_history) - CONFIG.metrics_window
                    num_to_train = min(num_sequences, num_available)
                    indices = np.random.choice(num_available, num_to_train, replace=False)
                    X = np.array([full_history[i:i + CONFIG.metrics_window] for i in indices])
                    y = np.array([full_history[i + CONFIG.metrics_window] for i in indices])
                    self.model.fit(X, y, epochs=1, verbose=0)
                    self.last_train_time = current_time
                    STATE.logger.log_event("INFO", f"Predictive model trained on {num_to_train} sequences")
        except Exception as e:
            STATE.logger.log_event("ERROR", "Predictive model training failed", {"error": str(e), "traceback": traceback.format_exc()})

    def predict(self, current: np.ndarray) -> np.ndarray:
        try:
            return self.model.predict(current[None, :], verbose=0)[0]
        except Exception as e:
            STATE.logger.log_event("ERROR", "Predictive model prediction failed", {"error": str(e), "traceback": traceback.format_exc()})
            return np.zeros(13, dtype=np.float32)

# --- Effectiveness Management ---
class EffectivenessManager:
    def __init__(self, file_path: str, backup_dir: str) -> None:
        try:
            self.file_path = Path(file_path)
            self.backup_dir = Path(backup_dir)
            self.backup_dir.mkdir(exist_ok=True)
            self.lock = threading.Lock()
            self.load()
        except Exception as e:
            STATE.logger.log_event("ERROR", "EffectivenessManager initialization failed", {"error": str(e), "traceback": traceback.format_exc()})
            raise

    def load(self) -> None:
        try:
            if self.file_path.exists():
                with self.file_path.open("r") as f:
                    STATE.effectiveness = json.load(f)
        except (json.JSONDecodeError, IOError) as e:
            STATE.logger.log_event("ERROR", f"Failed to load effectiveness: {str(e)}", {"traceback": traceback.format_exc()})
            STATE.effectiveness = {}

    def save(self) -> None:
        try:
            with self.lock:
                with self.file_path.open("w") as f:
                    json.dump(STATE.effectiveness, f)
                backup_path = self.backup_dir / f"effectiveness_{int(time.time())}.json"
                with backup_path.open("w") as f:
                    json.dump(STATE.effectiveness, f)
        except IOError as e:
            STATE.logger.log_event("ERROR", f"Failed to save effectiveness: {str(e)}", {"traceback": traceback.format_exc()})

    def update(self, action: str, success: bool) -> None:
        try:
            STATE.effectiveness.setdefault(action, {"success": 0, "failure": 0})
            key = "success" if success else "failure"
            STATE.effectiveness[action][key] += 1
        except Exception as e:
            STATE.logger.log_event("ERROR", "Effectiveness update failed", {"error": str(e), "traceback": traceback.format_exc()})

    def get_effectiveness(self, action: str) -> float:
        try:
            stats = STATE.effectiveness.get(action, {"success": 0, "failure": 0})
            total = stats["success"] + stats["failure"]
            return stats["success"] / total if total > 0 else 0.5
        except Exception as e:
            STATE.logger.log_event("ERROR", "Effectiveness retrieval failed", {"error": str(e), "traceback": traceback.format_exc()})
            return 0.5

# --- Chain of Thought Module ---
class OdenCoT:
    def __init__(self, oden_brain: OdenBrain, oden_policy: OdenPolicy, logger: logging.Logger, dynamics: 'OdenDynamics') -> None:
        try:
            self.brain = oden_brain
            self.policy = oden_policy
            self.logger = logger
            self.dynamics = dynamics
            self.action_history = deque(maxlen=100)
            self.rules = {
                "High CPU Usage": "Terminate",
                "Suspicious Network Activity": "Block",
                "Unusual User Activity": "Investigate",
                "High Disk I/O": "Quarantine",
            }
        except Exception as e:
            STATE.logger.log_event("ERROR", "OdenCoT initialization failed", {"error": str(e), "traceback": traceback.format_exc()})
            raise

    def assess_anomaly(self, metrics: np.ndarray, anomaly_score: float, cluster_distance: float) -> Dict[str, Any]:
        try:
            if metrics[0] > 80:
                anomaly_type = "High CPU Usage"
                metric_key = metrics[0]
            elif metrics[7] > 0:
                anomaly_type = "Suspicious Network Activity"
                metric_key = metrics[7]
            elif metrics[12] > 5:
                anomaly_type = "Unusual User Activity"
                metric_key = metrics[12]
            elif metrics[10] > 5e6:
                anomaly_type = "High Disk I/O"
                metric_key = metrics[10]
            else:
                anomaly_type = "Unknown Anomaly"
                metric_key = anomaly_score

            history = list(self.brain.memory)[-5:]
            persistent = len(history) > 0 and all(h[0][0] > 80 for h in history) if anomaly_type == "High CPU Usage" else False
            persistence_desc = "persistent" if persistent else "sudden"

            threat_detected = metrics[7] > 0 and any(str(metrics[7]) in ip for ip in STATE.bad_ips)
            threat_desc = "linked to known threat" if threat_detected else "no known threat"

            severity = "high" if (persistent or threat_detected or anomaly_score > 0.9 or cluster_distance > 2.0) else "medium"

            reasoning = {
                "type": anomaly_type,
                "value": float(metric_key),
                "persistence": persistence_desc,
                "threat": threat_desc,
                "severity": severity,
                "anomaly_score": float(anomaly_score),
                "cluster_distance": float(cluster_distance)
            }
            self.logger.log_event("INFO", f"Anomaly Assessment: {reasoning}")
            return reasoning
        except Exception as e:
            STATE.logger.log_event("ERROR", "Anomaly assessment failed", {"error": str(e), "traceback": traceback.format_exc()})
            return {"type": "Unknown", "value": 0.0, "persistence": "unknown", "threat": "unknown", "severity": "low", "anomaly_score": 0.0, "cluster_distance": 0.0}

    def select_action(self, state: Tuple[int, int, int, int, int], assessment: Dict[str, Any]) -> str:
        try:
            if assessment["type"] in self.rules:
                action = self.rules[assessment["type"]]
                self.logger.log_event("INFO", f"Rule-based action selected: {action}")
            else:
                if len(self.dynamics.memory) < 1000 or random.random() < self.policy.epsilon:
                    action = self.policy.choose_action(state)
                else:
                    current_metrics = list(STATE.metrics_history)[-1]
                    if not self.brain.scaler_fitted:
                        action = self.policy.choose_action(state)
                    else:
                        if 'consciousness' in globals():
                            action, expected_value = consciousness.imagine_future(current_metrics)
                        else:
                            normalized_current = self.brain.scaler.transform(current_metrics.reshape(1, -1))[0]
                            expected_values = []
                            for act in ACTIONS:
                                one_hot_action = np.zeros(len(ACTIONS))
                                one_hot_action[ACTIONS.index(act)] = 1
                                sequence_raw = list(STATE.metrics_history)[-3:] if len(STATE.metrics_history) >= 3 else [current_metrics] * 3
                                normalized_sequence = self.brain.scaler.transform(np.array(sequence_raw))
                                normalized_next = self.dynamics.model.predict([normalized_sequence[None, :], one_hot_action[None, :]], verbose=0)[0]
                                raw_next = self.brain.scaler.inverse_transform([normalized_next])[0]
                                anomaly_score_next, _, cluster_distance_next, _ = self.brain.predict(raw_next, use_history=False)
                                next_state = compute_state(raw_next, anomaly_score_next, cluster_distance_next)
                                max_q = np.max(self.policy.target_model.predict(np.array([next_state]), verbose=0)[0])
                                reward = estimate_reward(act, current_metrics, raw_next)
                                effectiveness_weight = eff_manager.get_effectiveness(act)
                                expected_value = (reward + self.policy.gamma * max_q) * effectiveness_weight
                                expected_values.append(expected_value)
                            action = ACTIONS[np.argmax(expected_values)]
            reasoning = {
                "anomaly_type": assessment["type"],
                "anomaly_score": assessment["anomaly_score"],
                "cluster_distance": assessment["cluster_distance"],
                "selected_action": action
            }
            self.action_history.append((time.time(), action, reasoning, None))
            return action
        except Exception as e:
            STATE.logger.log_event("ERROR", "Action selection failed", {"error": str(e), "traceback": traceback.format_exc()})
            return "Investigate"

    def evaluate_response(self, action: str, reward: float, pre_metrics: np.ndarray, post_metrics: np.ndarray) -> Dict[str, Any]:
        try:
            anomaly_change = float(self.brain.predict(pre_metrics)[0] - self.brain.predict(post_metrics)[0])
            success = reward > 0 and anomaly_change > 0
            reasoning = {
                "action": action,
                "reward": reward,
                "anomaly_change": anomaly_change,
                "success": success,
                "next_step": "Reinforce strategy" if success else "Adjust strategy"
            }
            if self.action_history and self.action_history[-1][1] == action:
                timestamp, act, reason, _ = self.action_history[-1]
                if 'consciousness' in globals():
                    reflection = consciousness.reflect(action, reward, pre_metrics, post_metrics)
                    reasoning["reflection"] = reflection
                self.action_history[-1] = (timestamp, action, reason, reasoning)
            self.logger.log_event("INFO", f"Response Evaluation: {reasoning}")
            return reasoning
        except Exception as e:
            STATE.logger.log_event("ERROR", "Response evaluation failed", {"error": str(e), "traceback": traceback.format_exc()})
            return {"action": action, "reward": reward, "anomaly_change": 0.0, "success": False, "next_step": "Adjust strategy"}

    def proactive_step(self, current_metrics: np.ndarray, predicted_metrics: np.ndarray) -> Optional[str]:
        try:
            current_score = self.brain.predict(current_metrics)[0]
            predicted_score = self.brain.predict(predicted_metrics, use_history=False)[0]
            if predicted_score > CONFIG.anomaly_threshold and predicted_score > current_score + 0.15:
                reasoning = f"Prediction: Anomaly score rises from {current_score:.2f} to {predicted_score:.2f}. Preemptive action needed."
                action = "Reinforce"
                self.logger.log_event("INFO", f"Proactive Step: {reasoning}")
                return action
            return None
        except Exception as e:
            STATE.logger.log_event("ERROR", "Proactive step failed", {"error": str(e), "traceback": traceback.format_exc()})
            return None

# --- System Monitoring ---
async def gather_metrics() -> np.ndarray:
    try:
        cpu = psutil.cpu_percent(interval=0.1)
        mem = psutil.virtual_memory().percent
        disk = psutil.disk_usage("/").percent
        net_io = psutil.net_io_counters()
        disk_io = psutil.disk_io_counters() or psutil._common.sdiskio(0, 0, 0, 0, 0, 0)
        processes = len(psutil.pids())
        connections = len(psutil.net_connections())
        bad_connections = sum(1 for conn in psutil.net_connections() if conn.raddr and conn.raddr.ip in STATE.bad_ips)
        latency = random.uniform(0, 10)
        process_metrics = []
        for p in psutil.process_iter(["cpu_percent", "memory_percent"]):
            try:
                cpu_val = p.info["cpu_percent"] or 0.0
                mem_val = p.info["memory_percent"] or 0.0
                process_metrics.append((cpu_val, mem_val))
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                process_metrics.append((0.0, 0.0))
        max_cpu = max(pm[0] for pm in process_metrics) if process_metrics else 0.0
        max_mem = max(pm[1] for pm in process_metrics) if process_metrics else 0.0
        user_logins = len([conn for conn in psutil.net_connections() if conn.laddr.port == 22])

        metrics = np.array([cpu, mem, disk, net_io.bytes_sent, net_io.bytes_recv, processes, connections,
                            bad_connections, max_cpu, max_mem, disk_io.read_bytes, latency, user_logins], dtype=np.float32)

        signature_detector = SignatureDetector("threat_signatures.json")
        detected_signatures = signature_detector.check_metrics(metrics)
        if detected_signatures:
            STATE.logger.log_event("WARNING", "Detected threat signatures", {"signatures": detected_signatures})
            await send_notification({"threat_signatures": detected_signatures})

        return metrics
    except Exception as e:
        STATE.logger.log_event("ERROR", "Metrics gathering failed", {"error": str(e), "traceback": traceback.format_exc()})
        if STATE.metrics_history:
            return np.array(list(STATE.metrics_history)[-1], dtype=np.float32)
        return np.zeros(13, dtype=np.float32)

# --- Threat Intelligence ---
async def fetch_with_retry(session: aiohttp.ClientSession, url: str, headers: Dict[str, str], retries: int = 3, delay: float = 1.0) -> Optional[Dict[str, Any]]:
    for attempt in range(retries):
        try:
            async with session.get(url, headers=headers) as resp:
                if resp.status == 200:
                    return await resp.json()
                else:
                    STATE.logger.log_event("WARNING", f"Attempt {attempt+1}: Threat intel fetch from {url} failed with status {resp.status}")
        except Exception as e:
            STATE.logger.log_event("ERROR", f"Attempt {attempt+1}: Exception fetching threat intel from {url}", {"error": str(e), "traceback": traceback.format_exc()})
        await asyncio.sleep(delay * (2 ** attempt))
    return None

async def refresh_threat_intel() -> None:
    try:
        async with aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=10)) as session:
            while STATE.active:
                bad_ips = set()
                for source in CONFIG.threat_intel_sources:
                    try:
                        headers = {"x-apikey": source["key"]} if "virustotal" in source["url"] else {"Key": source["key"], "Accept": "application/json"}
                        data = await fetch_with_retry(session, source["url"], headers)
                        if data:
                            ips = {entry[source["ip_key"]] for entry in data.get(source["field"], []) if source["ip_key"] in entry}
                            bad_ips.update(ips)
                            STATE.logger.log_event("INFO", f"Threat intel from {source['url']}: {len(ips)} IPs")
                    except Exception as e:
                        STATE.logger.log_event("ERROR", f"Threat intel refresh from {source['url']} failed: {str(e)}", {"traceback": traceback.format_exc()})
                STATE.bad_ips = bad_ips
                await asyncio.sleep(CONFIG.threat_intel_interval)
    except Exception as e:
        STATE.logger.log_event("ERROR", "Threat intelligence refresh loop failed", {"error": str(e), "traceback": traceback.format_exc()})

# --- Action Execution ---
async def execute_action(action: str, context: Dict[str, Any], eff_manager: EffectivenessManager) -> float:
    try:
        current_time = time.time()
        if current_time - STATE.last_action_time < CONFIG.action_cooldown:
            return 0.0
        STATE.last_action_time = current_time

        metrics = await gather_metrics()
        predictive_model = PredictiveModel()
        history = np.array(list(STATE.metrics_history)[-CONFIG.metrics_window:] if len(STATE.metrics_history) >= CONFIG.metrics_window else np.zeros((CONFIG.metrics_window, 13)))
        simulated_metrics = predictive_model.predict(history)
        simulated_score = oden_brain.predict(simulated_metrics, use_history=False)[0]

        reward = 0.0
        if action == "Terminate":
            target = max([p for p in psutil.process_iter(["pid", "cpu_percent", "name", "create_time"])
                          if p.info["name"].lower() not in CRITICAL_PROCESSES and p.info["cpu_percent"] > 50
                          and time.time() - p.info["create_time"] < 300],
                         key=lambda p: p.info["cpu_percent"] or 0, default=None)
            if target:
                psutil.Process(target.info["pid"]).terminate()
                await asyncio.sleep(0.1)
                reward = 1.5 if psutil.cpu_percent() < 80 else -0.5
                STATE.logger.log_event("INFO", f"Terminated PID {target.info['pid']}")
        elif action == "Encrypt":
            file_path = Path("sensitive_data.txt")
            if file_path.exists():
                with file_path.open("rb") as f:
                    encrypted = STATE.cipher.encrypt(f.read())
                Path("sensitive_data.enc").write_bytes(encrypted)
                reward = 1.2
        elif action == "Transmit":
            await send_notification(context)
            reward = 0.7
        elif action == "Delete":
            suspicious = [f for f in os.listdir() if f.endswith((".exe", ".tmp")) and os.path.getctime(f) > time.time() - 3600]
            if simulated_score < oden_brain.predict(metrics)[0]:
                for f in suspicious[:2]:
                    os.remove(f)
                    reward += 1.0
        elif action == "Investigate":
            with Path("oden_investigation.txt").open("w") as f:
                for proc in psutil.process_iter(["pid", "name", "cpu_percent", "memory_percent"]):
                    cpu = proc.info["cpu_percent"] or 0
                    mem = proc.info["memory_percent"] or 0
                    if cpu > 80 or mem > 50:
                        f.write(f"Suspicious: PID: {proc.info['pid']}, Name: {proc.info['name']}, CPU: {cpu}, Mem: {mem}\n")
            reward = 0.5
        elif action == "Block":
            bad_ips = context.get("bad_ips", [])
            for ip in bad_ips[:10]:
                subprocess.run(["iptables", "-A", "INPUT", "-s", ip, "-j", "DROP"], check=False)
            reward = 1.5 if bad_ips else 0.0
        elif action == "Quarantine":
            quarantine_dir = Path("quarantine")
            quarantine_dir.mkdir(exist_ok=True)
            suspicious = [f for f in os.listdir() if f.endswith((".exe", ".tmp"))]
            for f in suspicious[:2]:
                Path(f).rename(quarantine_dir / f)
            reward = 0.8
        elif action == "Isolate":
            pid = context.get("pid")
            if pid and pid in psutil.pids():
                p = psutil.Process(pid)
                if p.name().lower() not in CRITICAL_PROCESSES and p.uids().real != 0:
                    subprocess.run(["nice", "-n", "19", str(pid)], check=False)
                    reward = 1.0
        elif action == "Repair":
            if "file_path" in context:
                file_path = Path(context["file_path"])
                backup_path = Path(CONFIG.backup_dir) / f"{file_path.name}.bak"
                if backup_path.exists() and file_path.exists():
                    file_path.write_bytes(backup_path.read_bytes())
                    reward = 1.2
        elif action == "Reinforce":
            CONFIG.check_interval = max(0.1, CONFIG.check_interval * 0.7)
            threading.Timer(300, lambda: setattr(CONFIG, "check_interval", 1.0)).start()
            reward = 0.8

        eff_manager.update(action, reward > 0)
        return reward
    except Exception as e:
        STATE.logger.log_event("ERROR", f"Action '{action}' execution failed", {"error": str(e), "traceback": traceback.format_exc()})
        eff_manager.update(action, False)
        return -1.0

