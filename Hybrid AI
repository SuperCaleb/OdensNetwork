            np.save(os.path.join(self.data_dir, f"action_sequences_{int(time.time())}.npy"), np.array(self.action_sequences))
            self.action_sequences = []

    def compute_consistency_scores(self, tracks, audio_events):
        consistency = {}
        for event, conditions in self.events.items():
            visual_match = conditions["visual"](tracks)
            audio_match = conditions["audio"](audio_events)
            consistency[event] = min(visual_match, audio_match)
        return consistency

    def reason(self, tracks, interactions):
        current_time = datetime.now()
        recent_audio_events = [event for t, event in self.audio_events if (current_time - t).total_seconds() < 1]
        consistency = self.compute_consistency_scores(tracks, recent_audio_events)
        max_consistency = max(consistency.values()) if consistency else 0
        temperature = max(0.1, 1 - max_consistency)
        boosts = [max(consistency.get(event, 0) for event in self.action_relevance.get(action, [])) if self.action_relevance.get(action) else 0 for action in range(self.rl_learner.action_size)]
        state = self._get_state(tracks)
        action = self.rl_learner.choose_action(state, boosts=boosts, temperature=temperature)
        self._perform_action(action)

    def _get_state(self, tracks):
        num_people = len([t for t in tracks if t["type"] == "person"])
        num_objects = len(tracks) - num_people
        return min(num_people + num_objects, 99)

    def _perform_action(self, action):
        actions = {0: "Increasing alert sensitivity.", 1: "Focusing on person tracks.", 2: "Analyzing audio more closely.", 3: "Logging detailed scene data.", 4: "No action taken."}
        message = actions.get(action, "Unknown action.")
        self.speak(message)
        self.log_file.write(json.dumps({"timestamp": datetime.now().strftime("%H:%M:%S"), "event": "action", "action": message}) + "\n")

    def learn_from_feedback(self, feedback):
        state = self._get_state(self.active_tracks.values())
        action = self.rl_learner.choose_action(state)
        reward = 1 if feedback == "correct" else -1
        next_state = self._get_state(self.active_tracks.values())
        self.rl_learner.learn(state, action, reward, next_state)

    def update_context(self):
        current_hour = datetime.now().hour
        time_of_day = "night" if current_hour < 6 or current_hour > 18 else "day"
        self.context_manager.update_context({"time_of_day": time_of_day})

    def evolve(self):
        self.evo_optimizer.evolve()
        best_params = self.evo_optimizer.population[0]
        self.log_file.write(json.dumps({"timestamp": datetime.now().strftime("%H:%M:%S"), "event": "evolution", "best_params": best_params.tolist()}) + "\n")

    def object_detector(self, hws_queue):
        print("🚀 HWS - Next-Gen Forensic Intelligence System with Orch OR Integration")
        fps = self.cap.get(cv2.CAP_PROP_FPS) or 30
        pose_buffer = deque(maxlen=10)
        while self.cap.isOpened():
            ret, frame = self.cap.read()
            if not ret:
                break
            current_time = datetime.now().strftime("%H:%M:%S")
            depth_map = self.estimate_depth(frame)
            self.update_context()
            yolo_results = self.yolo_model(frame, conf=0.5)
            rcnn_input = torch.from_numpy(frame.transpose(2, 0, 1)).float().unsqueeze(0) / 255.0
            if torch.cuda.is_available():
                rcnn_input = rcnn_input.cuda()
            rcnn_results = self.rcnn_model(rcnn_input)[0]
            detections = []
            for yolo_box in yolo_results[0].boxes:
                xyxy = yolo_box.xyxy[0].cpu().numpy()
                conf = yolo_box.conf[0].item()
                cls = int(yolo_box.cls[0].item())
                if conf < 0.7:
                    self.low_conf_detections.append({"frame": frame.tolist(), "box": xyxy.tolist(), "conf": conf, "cls": cls})
                detections.append([xyxy, conf, self.class_labels.get(cls, "unknown")])
            for i, box in enumerate(rcnn_results["boxes"]):
                if rcnn_results["scores"][i] > 0.5:
                    xyxy = box.cpu().detach().numpy()
                    conf = rcnn_results["scores"][i].item()
                    cls = rcnn_results["labels"][i].item()
                    if conf < 0.7:
                        self.low_conf_detections.append({"frame": frame.tolist(), "box": xyxy.tolist(), "conf": conf, "cls": cls})
                    detections.append([xyxy, conf, self.class_labels.get(cls, "unknown")])
            boxes = [d[0] for d in detections]
            scores = [d[1] for d in detections]
            labels = [d[2] for d in detections]
            indices = cv2.dnn.NMSBoxes(boxes, scores, score_threshold=0.5, nms_threshold=0.4)
            detections = [detections[i] for i in indices]
            tracks = self.tracker.update_tracks(detections, frame=frame)
            current_track_dict = {t.track_id: t.det_class for t in tracks if t.is_confirmed()}
            missing_ids = set(self.active_tracks.keys()) - set(current_track_dict.keys())
            for missing_id in missing_ids:
                self.lost_tracks.append({"track_id": missing_id, "last_frame": frame.copy()})
            new_ids = set(current_track_dict.keys()) - set(self.active_tracks.keys())
            for new_id in new_ids:
                det_class = current_track_dict[new_id]
                self.speak(f"{det_class.capitalize()} ID {new_id} entered the scene.")
                self.active_tracks[new_id] = {"type": det_class, "missing_count": 0, "track_id": new_id}
                self.log_file.write(json.dumps({"timestamp": current_time, "event": "entry", "track_id": new_id, "type": det_class}) + '\n')
            for missing_id in missing_ids:
                self.active_tracks[missing_id]["missing_count"] += 1
                if self.active_tracks[missing_id]["missing_count"] >= 30:
                    det_class = self.active_tracks[missing_id]["type"]
                    self.speak(f"{det_class.capitalize()} ID {missing_id} left the scene.")
                    self.log_file.write(json.dumps({"timestamp": current_time, "event": "exit", "track_id": missing_id, "type": det_class}) + '\n')
                    del self.active_tracks[missing_id]
            rgb_frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
            pose_results = self.pose.process(rgb_frame)
            people_tracks = [t for t in tracks if t.det_class == "person"]
            object_tracks = [t for t in tracks if t.det_class != "person"]
            interactions = {}
            if pose_results.pose_landmarks:
                for landmarks in pose_results.pose_landmarks:
                    pose_vec = np.array([[lm.x, lm.y, lm.z] for lm in landmarks.landmark if lm.visibility > 0.7]).flatten()
                    if len(pose_vec) == 99:
                        pose_buffer.append(pose_vec)
                        if len(pose_buffer) == 10:
                            pose_tensor = torch.tensor(list(pose_buffer), dtype=torch.float32).unsqueeze(0)
                            with torch.no_grad():
                                action_pred = self.action_model(pose_tensor)[0][-1].argmax().item()
                            self.action_sequences.append((list(pose_buffer), action_pred))
            scene_vector = self.compute_scene_vector(tracks, pose_results, self.audio_events, depth_map)
            if self.detect_anomaly(scene_vector):
                self.speak("Scene anomaly detected, potential tampering or unusual activity.")
            track_data = []
            for track in tracks:
                if not track.is_confirmed():
                    continue
                box = track.to_tlbr()
                obj_type = track.det_class
                location = self.get_location(box, depth_map)
                action = self.action_labels.get(action_pred if obj_type == "person" else 3, "stationary")
                track_id = track.track_id
                if track_id not in self.object_positions:
                    self.object_positions[track_id] = deque(maxlen=20)
                self.object_positions[track_id].append(box)
                depth_value = depth_map[int((box[1] + box[3]) / 2), int((box[0] + box[2]) / 2)]
                label = f"ID: {track_id} - {obj_type} ({action}) - Depth: {depth_value:.2f}m"
                cv2.rectangle(frame, (int(box[0]), int(box[1])), (int(box[2]), int(box[3])), (0, 255, 0), 2)
                cv2.putText(frame, label, (int(box[0]), int(box[1]) - 10), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 0), 2)
                log_entry = {"timestamp": current_time, "track_id": track_id, "type": obj_type, "location": location, "action": action, "depth": float(depth_value)}
                self.log_file.write(json.dumps(log_entry) + '\n')
                track_data.append({"type": obj_type, "location": location, "action": action, "track_id": track_id, "box": box})
            self.reason(track_data, interactions)
            if self.frame_counter % 1000 == 0:
                self.evolve()
            self.frame_counter += 1
            if self.frame_counter % 100 == 0:
                narrative = self.generate_narrative(track_data, [f"Interaction between {k[0]} and {k[1]}" for k in self.interaction_history.keys()])
                self.speak(narrative)
                self.save_learning_data()
            self.out.write(frame)
            cv2.imshow("HWS - He Who Sees", frame)
            if cv2.waitKey(1) & 0xFF == ord('q'):
                break
            # Share data with Oden
            hws_data = {
                'num_persons': len([t for t in tracks if t.det_class == "person"]),
                'num_weapons': len([t for t in tracks if t.det_class in ["knife", "gun"]])
            }
            hws_queue.put(hws_data)
        self._cleanup()
        cv2.destroyAllWindows()

