def compute_state(metrics: np.ndarray, anomaly_score: float, cluster_distance: float) -> Tuple[int, int, int, int, int]:
    anomaly_bin = np.digitize(anomaly_score, ANOMALY_BINS) - 1
    cpu_bin = np.digitize(metrics[0], CPU_BINS) - 1
    mem_bin = np.digitize(metrics[1], MEM_BINS) - 1
    bad_conn_bin = np.digitize(metrics[7], BAD_CONN_BINS) - 1
    disk_io_bin = np.digitize(metrics[10], DISK_IO_BINS) - 1
    return (anomaly_bin, cpu_bin, mem_bin, bad_conn_bin, disk_io_bin)

