# --- Enhanced Neural Network with Holonomic Enhancements and Core Consciousness ---
class OdenBrain:
    def __init__(self):
        self.model = self._build_model()
        self.holo_memory = HolographicMemory()
        self.optimizer = tf.keras.optimizers.Adam(learning_rate=CONFIG.learning_rate)
        self.memory = deque(maxlen=CONFIG.memory_size)
        self.epsilon = CONFIG.epsilon_initial
        self.scaler = SCALER
        self.scaler_fitted = False
        self.mse_threshold = None
        self.cluster_model = None
        self.mse_mean = 0.0
        self.mse_var = 0.0
        self.mse_count = 0
        self.batch_size = 32

    def _build_model(self) -> tf.keras.Model:
        inputs = layers.Input(shape=(CONFIG.metrics_window, 15))  # Updated for HWS features
        inputs_transposed = layers.Lambda(lambda x: tf.transpose(x, perm=[0, 2, 1]))(inputs)
        fft_transposed = layers.Lambda(lambda x: tf.signal.fft(tf.cast(x, tf.complex64)))(inputs_transposed)
        fft = layers.Lambda(lambda x: tf.transpose(x, perm=[0, 2, 1]))(fft_transposed)
        fft_real = layers.Lambda(lambda x: tf.math.real(x))(fft)
        fft_imag = layers.Lambda(lambda x: tf.math.imag(x))(fft)
        fft_features = layers.Concatenate(axis=-1)([fft_real, fft_imag])
        combined_inputs = layers.Concatenate(axis=-1)([inputs, fft_features])
        conv1 = layers.Conv1D(32, 3, dilation_rate=1, padding='same', activation='relu')(combined_inputs)
        conv2 = layers.Conv1D(32, 3, dilation_rate=2, padding='same', activation='relu')(combined_inputs)
        conv3 = layers.Conv1D(32, 3, dilation_rate=4, padding='same', activation='relu')(combined_inputs)
        conv_concat = layers.Concatenate()([conv1, conv2, conv3])
        x = layers.Dense(64)(conv_concat)
        x = PositionalEncoding(CONFIG.metrics_window, 64)(x)
        x = TransformerEncoderLayer(d_model=64, num_heads=4, ff_dim=128)(x)
        x = layers.LSTM(32, return_sequences=True)(x)
        recon_out = layers.TimeDistributed(layers.Dense(15))(x)  # Updated for HWS features
        pooled = layers.GlobalAveragePooling1D()(x)
        class_out = layers.Dense(1, activation="sigmoid", name="anomaly_score")(pooled)
        model = Model(inputs, [recon_out, class_out, pooled])
        model.compile(
            optimizer="adam",
            loss=["mse", "binary_crossentropy", None],
            loss_weights=[0.6, 0.4, 0.0]
        )
        return model

    def predict(self, metrics: np.ndarray, use_history: bool = True) -> Tuple[float, float, float]:
        padded = self._prepare_metrics(metrics, use_history)
        if self.scaler_fitted:
            normalized = self.scaler.transform(padded).astype(np.float32)
        else:
            normalized = padded.astype(np.float32)
            STATE.logger.log_event("DEBUG", "Scaler not fitted; using raw metrics")
        batch = tf.convert_to_tensor(normalized[None, :], dtype=tf.float32)
        recon, class_prob, pooled = self.model(batch, training=False)
        mse = tf.reduce_mean(tf.square(batch - recon), axis=[1, 2]).numpy()[0]
        anomaly_score = self._scale_mse(mse)
        class_score = class_prob[0][0].numpy()
        cluster_distance = self._compute_cluster_distance(normalized) if self.cluster_model else 0.0

        if self.holo_memory.index > 0:
            indices, similarities = self.holo_memory.query(pooled[0], top_k=5)
            memory_anomaly = 1 - np.mean(np.clip(similarities, 0, 1)) if len(similarities) > 0 else 1.0
            anomaly_score = max(anomaly_score, memory_anomaly)

        if anomaly_score < 0.1:
            self.holo_memory.add(pooled[0])

        if 'consciousness' in globals():
            consciousness.update_self_state(metrics)

        return anomaly_score, class_score, cluster_distance

    def _compute_cluster_distance(self, normalized: np.ndarray) -> float:
        centers = self.cluster_model.cluster_centers_
        distances = np.linalg.norm(centers - normalized[-1], axis=1)
        return np.min(distances)

    def train(self, metrics: np.ndarray, label: Optional[float] = None, batch_train: bool = False) -> None:
        padded = self._prepare_metrics(metrics, True)
        if not self.scaler_fitted:
            self.scaler.fit(padded)
            self.scaler_fitted = True
        else:
            self.scaler.partial_fit(padded)
        normalized = self.scaler.transform(padded).astype(np.float32)
        self.memory.append((normalized, label))

        if len(self.memory) >= self.batch_size:
            batch = random.sample(self.memory, self.batch_size)
            X = np.array([d[0] for d in batch])
            y_recon = X
            y_class = np.array([d[1] if d[1] is not None else self.predict(d[0])[1] for d in batch]).reshape(-1, 1)
            y_pooled = np.zeros((self.batch_size, 32))
            loss = self.model.train_on_batch(X, [y_recon, y_class, y_pooled])
            STATE.logger.log_event("INFO", f"Online training completed, loss: {loss}")

        if len(self.memory) >= 50 and (self.cluster_model is None or batch_train):
            data = np.array([m[0][-1] for m in self.memory])
            self.cluster_model = KMeans(n_clusters=5).fit(data)
            STATE.logger.log_event("INFO", "Clustering model updated")

        mse = tf.reduce_mean(tf.square(normalized - self.model(normalized[None, :])[0])).numpy()
        self._update_mse_stats(mse)

    def _update_mse_stats(self, mse: float) -> None:
        self.mse_count += 1
        delta = mse - self.mse_mean
        self.mse_mean += delta / self.mse_count
        self.mse_var += delta * (mse - self.mse_mean)
        self.mse_threshold = self.mse_mean + 3 * np.sqrt(self.mse_var / max(1, self.mse_count - 1)) if self.mse_count > 1 else mse * 10

    def _scale_mse(self, mse: float) -> float:
        if self.mse_threshold is None:
            return min(mse * 100, 1.0)
        return min(mse / self.mse_threshold, 1.0)

    def _prepare_metrics(self, metrics: np.ndarray, use_history: bool) -> np.ndarray:
        if use_history:
            STATE.metrics_history.append(metrics)
            history = list(STATE.metrics_history)
            if len(history) < CONFIG.metrics_window:
                padded = np.zeros((CONFIG.metrics_window, 15), dtype=np.float32)  # Updated for HWS features
                padded[-len(history):] = history
            else:
                padded = np.array(history[-CONFIG.metrics_window:], dtype=np.float32)
        else:
            padded = metrics.astype(np.float32)
        return padded

    def decay_epsilon(self) -> None:
        self.epsilon = max(CONFIG.epsilon_min, self.epsilon * CONFIG.epsilon_decay)

    def validate(self, validation_data: Optional[np.ndarray] = None) -> bool:
        if validation_data is None and len(STATE.metrics_history) >= CONFIG.metrics_window:
            validation_data = np.array(list(STATE.metrics_history)[-CONFIG.metrics_window:], dtype=np.float32)
        elif validation_data is None:
            validation_data = np.random.rand(CONFIG.metrics_window, 15).astype(np.float32)  # Updated for HWS features
        if self.scaler_fitted:
            validation_data = self.scaler.transform(validation_data).astype(np.float32)
        batch = tf.convert_to_tensor(validation_data[None, :], dtype=tf.float32)
        recon, _, _ = self.model.predict(batch, verbose=0)
        mse = tf.reduce_mean(tf.square(batch - recon)).numpy()
        threshold = self.mse_threshold or 0.1
        return mse < threshold

# --- Enhanced Reinforcement Learning Policy with Emotional Valence ---
class OdenPolicy:
    def __init__(self):
        self.memory = deque(maxlen=10000)
        self.gamma = 0.97
        self.epsilon = CONFIG.epsilon_initial
        self.epsilon_min = CONFIG.epsilon_min
        self.epsilon_decay = CONFIG.epsilon_decay
        self.learning_rate = CONFIG.learning_rate
        self.batch_size = 64
        self.target_update_freq = 25
        self.q_model = self._build_model()
        self.target_model = self._build_model()
        self.update_target_model()
        self.steps = 0

    def _build_model(self) -> tf.keras.Model:
        model = Sequential([
            layers.Input(shape=(5,)),
            layers.Dense(256, activation='relu'),
            layers.Dense(256, activation='relu'),
            layers.Dense(len(ACTIONS))
        ])
        model.compile(optimizer=tf.keras.optimizers.Adam(learning_rate=self.learning_rate), loss='mse')
        return model

    def update_target_model(self):
        self.target_model.set_weights(self.q_model.get_weights())

    def choose_action(self, state: Tuple[int, int, int, int, int]) -> str:
        if random.random() < self.epsilon:
            return random.choice(ACTIONS)
        q_values = self.q_model.predict(np.array([state]), verbose=0)[0]
        if 'consciousness' in globals():
            valence = consciousness.emotional_valence
            q_values = q_values * (1 + valence * 0.2)
        return ACTIONS[np.argmax(q_values)]

    def learn(self, state: Tuple[int, int, int, int, int], action: str, reward: float,
              next_state: Tuple[int, int, int, int, int]) -> None:
        self.memory.append((state, action, reward, next_state, False))
        self.replay()

    def replay(self):
        if len(self.memory) < self.batch_size:
            return
        minibatch = random.sample(self.memory, self.batch_size)
        states = np.array([t[0] for t in minibatch])
        actions = [ACTIONS.index(t[1]) for t in minibatch]
        rewards = [t[2] for t in minibatch]
        next_states = np.array([t[3] for t in minibatch])
        dones = [t[4] for t in minibatch]

        targets = self.q_model.predict(states, verbose=0)
        next_q_values = self.target_model.predict(next_states, verbose=0)
        for i in range(self.batch_size):
            if dones[i]:
                targets[i][actions[i]] = rewards[i]
            else:
                targets[i][actions[i]] = rewards[i] + self.gamma * np.max(next_q_values[i])
        self.q_model.fit(states, targets, epochs=1, verbose=0)
        self.epsilon = max(self.epsilon_min, self.epsilon * self.epsilon_decay)
        self.steps += 1
        if self.steps % self.target_update_freq == 0:
            self.update_target_model()

    def compute_stability_reward(self) -> float:
        recent_scores = list(STATE.anomaly_history)[-10:]
        avg_score = np.mean(recent_scores) if recent_scores else 0.0
        std_score = np.std(recent_scores) if recent_scores else 0.0
        return -avg_score - 0.5 * std_score

# --- Dynamics Model ---
class OdenDynamics:
    def __init__(self):
        self.model = self._build_model()
        self.memory = deque(maxlen=10000)

    def _build_model(self) -> tf.keras.Model:
        inputs_states = layers.Input(shape=(3, 15))  # Updated for HWS features
        inputs_action = layers.Input(shape=(len(ACTIONS),))
        x = layers.LSTM(64)(inputs_states)
        x = layers.Concatenate()([x, inputs_action])
        x = layers.Dense(128, activation='relu')(x)
        outputs = layers.Dense(15)(x)  # Updated for HWS features
        model = Model(inputs=[inputs_states, inputs_action], outputs=outputs)
        model.compile(optimizer='adam', loss='mse')
        return model

    def remember(self, sequence_metrics, action, normalized_next_metrics):
        if len(sequence_metrics) < 3:
            sequence_raw = list(sequence_metrics)
            while len(sequence_raw) < 3:
                sequence_raw.insert(0, sequence_raw[0] if sequence_raw else np.zeros(15))
            sequence_raw = sequence_raw[-3:]
        else:
            sequence_raw = list(sequence_metrics)[-3:]
        normalized_sequence = oden_brain.scaler.transform(np.array(sequence_raw))
        one_hot_action = np.zeros(len(ACTIONS))
        one_hot_action[ACTIONS.index(action)] = 1
        self.memory.append((normalized_sequence, one_hot_action, normalized_next_metrics))

    def train(self):
        if len(self.memory) < 1000:
            return
        batch = random.sample(self.memory, 256)
        X_states = np.array([d[0] for d in batch])
        X_actions = np.array([d[1] for d in batch])
        Y = np.array([d[2] for d in batch])
        self.model.fit([X_states, X_actions], Y, epochs=1, verbose=0)

# --- Enhanced Reward Estimation ---
def estimate_reward(action: str, current_metrics: np.ndarray, next_metrics: np.ndarray) -> float:
    stability_bonus = oden_policy.compute_stability_reward()
    if action == "Terminate":
        return 1.5 if next_metrics[0] < 80 and next_metrics[8] < 50 else -0.5 + stability_bonus
    elif action == "Encrypt":
        return 1.2 + stability_bonus
    elif action == "Transmit":
        return 0.7 + stability_bonus
    elif action == "Delete":
        return 1.0 if next_metrics[0] < current_metrics[0] else 0.0 + stability_bonus
    elif action == "Investigate":
        return 0.5 + stability_bonus
    elif action == "Block":
        return 1.5 if next_metrics[7] == 0 else 0.0 + stability_bonus
    elif action == "Quarantine":
        return 0.8 + stability_bonus
    elif action == "Isolate":
        return 1.0 + stability_bonus
    elif action == "Repair":
        return 1.2 if next_metrics[0] < current_metrics[0] else 0.0 + stability_bonus
    elif action == "Reinforce":
        return 0.8 + stability_bonus
    return stability_bonus

# --- Predictive Model with Bidirectional LSTM ---
class PredictiveModel:
    def __init__(self):
        self.model = Sequential([
            layers.Input(shape=(CONFIG.metrics_window, 15)),  # Updated for HWS features
            layers.Bidirectional(layers.LSTM(64)),
            layers.Dense(15)  # Updated for HWS features
        ])
        self.model.compile(optimizer="adam", loss="mse")
        self.last_train_time = 0
        self.train_interval = 20

    def train(self, full_history: np.ndarray, force: bool = False, num_sequences: int = 100):
        current_time = time.time()
        if force or (current_time - self.last_train_time > self.train_interval * CONFIG.check_interval):
            if len(full_history) > CONFIG.metrics_window:
                num_available = len(full_history) - CONFIG.metrics_window
                num_to_train = min(num_sequences, num_available)
                indices = np.random.choice(num_available, num_to_train, replace=False)
                X = np.array([full_history[i:i + CONFIG.metrics_window] for i in indices])
                y = np.array([full_history[i + CONFIG.metrics_window] for i in indices])
                self.model.fit(X, y, epochs=1, verbose=0)
                self.last_train_time = current_time
                STATE.logger.log_event("INFO", f"Predictive model trained on {num_to_train} sequences")

    def predict(self, current: np.ndarray) -> np.ndarray:
        return self.model.predict(current[None, :], verbose=0)[0]

# --- Effectiveness Management ---
class EffectivenessManager:
    def __init__(self, file_path: str, backup_dir: str):
        self.file_path = Path(file_path)
        self.backup_dir = Path(backup_dir)
        self.backup_dir.mkdir(exist_ok=True)
        self.lock = threading.Lock()
        self.load()

    def load(self) -> None:
        if self.file_path.exists():
            try:
                with self.file_path.open("r") as f:
                    STATE.effectiveness = json.load(f)
            except (json.JSONDecodeError, IOError) as e:
                STATE.logger.log_event("ERROR", f"Failed to load effectiveness: {str(e)}")
                STATE.effectiveness = {}

    def save(self) -> None:
        with self.lock:
            try:
                with self.file_path.open("w") as f:
                    json.dump(STATE.effectiveness, f)
                backup_path = self.backup_dir / f"effectiveness_{int(time.time())}.json"
                with backup_path.open("w") as f:
                    json.dump(STATE.effectiveness, f)
            except IOError as e:
                STATE.logger.log_event("ERROR", f"Failed to save effectiveness: {str(e)}")

    def update(self, action: str, success: bool) -> None:
        STATE.effectiveness.setdefault(action, {"success": 0, "failure": 0})
        key = "success" if success else "failure"
        STATE.effectiveness[action][key] += 1

    def get_effectiveness(self, action: str) -> float:
        stats = STATE.effectiveness.get(action, {"success": 0, "failure": 0})
        total = stats["success"] + stats["failure"]
        return stats["success"] / total if total > 0 else 0.5

# --- Enhanced Chain of Thought Module with Reflection and Imagination ---
class OdenCoT:
    def __init__(self, oden_brain: OdenBrain, oden_policy: OdenPolicy, logger: logging.Logger, dynamics: 'OdenDynamics'):
        self.brain = oden_brain
        self.policy = oden_policy
        self.logger = logger
        self.dynamics = dynamics
        self.action_history = deque(maxlen=100)
        self.rules = {
            "High CPU Usage": "Terminate",
            "Suspicious Network Activity": "Block",
            "Unusual User Activity": "Investigate",
            "High Disk I/O": "Quarantine",
        }

    def assess_anomaly(self, metrics: np.ndarray, anomaly_score: float, cluster_distance: float) -> Dict[str, Any]:
        if metrics[0] > 80:
            anomaly_type = "High CPU Usage"
            metric_key = metrics[0]
        elif metrics[7] > 0:
            anomaly_type = "Suspicious Network Activity"
            metric_key = metrics[7]
        elif metrics[12] > 5:
            anomaly_type = "Unusual User Activity"
            metric_key = metrics[12]
        elif metrics[10] > 5e6:
            anomaly_type = "High Disk I/O"
            metric_key = metrics[10]
        elif metrics[13] > 0 and metrics[14] > 0:  # HWS: person with weapon
            anomaly_type = "Potential Physical Threat"
            metric_key = metrics[14]
        else:
            anomaly_type = "Unknown Anomaly"
            metric_key = anomaly_score

        history = list(self.brain.memory)[-5:]
        persistent = len(history) > 0 and all(h[0][0] > 80 for h in history) if anomaly_type == "High CPU Usage" else False
        persistence_desc = "persistent" if persistent else "sudden"

        threat_detected = metrics[7] > 0 and any(str(metrics[7]) in ip for ip in STATE.bad_ips)
        threat_desc = "linked to known threat" if threat_detected else "no known threat"

        severity = "high" if (persistent or threat_detected or anomaly_score > 0.9 or cluster_distance > 2.0 or metrics[14] > 0) else "medium"

        reasoning = {
            "type": anomaly_type,
            "value": float(metric_key),
            "persistence": persistence_desc,
            "threat": threat_desc,
            "severity": severity,
            "anomaly_score": float(anomaly_score),
            "cluster_distance": float(cluster_distance)
        }
        self.logger.log_event("INFO", f"Anomaly Assessment: {reasoning}")
        return reasoning

    def select_action(self, state: Tuple[int, int, int, int, int], assessment: Dict[str, Any]) -> str:
        if assessment["type"] in self.rules:
            action = self.rules[assessment["type"]]
            self.logger.log_event("INFO", f"Rule-based action selected: {action}")
        else:
            if len(self.dynamics.memory) < 1000 or random.random() < self.policy.epsilon:
                action = self.policy.choose_action(state)
            else:
                current_metrics = list(STATE.metrics_history)[-1]
                if not self.brain.scaler_fitted:
                    action = self.policy.choose_action(state)
                else:
                    if 'consciousness' in globals():
                        action, expected_value = consciousness.imagine_future(current_metrics)
                    else:
                        normalized_current = self.brain.scaler.transform(current_metrics.reshape(1, -1))[0]
                        expected_values = []
                        for act in ACTIONS:
                            one_hot_action = np.zeros(len(ACTIONS))
                            one_hot_action[ACTIONS.index(act)] = 1
                            sequence_raw = list(STATE.metrics_history)[-3:] if len(STATE.metrics_history) >= 3 else [current_metrics] * 3
                            normalized_sequence = self.brain.scaler.transform(np.array(sequence_raw))
                            normalized_next = self.dynamics.model.predict([normalized_sequence[None, :], one_hot_action[None, :]], verbose=0)[0]
                            raw_next = self.brain.scaler.inverse_transform([normalized_next])[0]
                            anomaly_score, _, cluster_distance = self.brain.predict(raw_next, use_history=False)
                            next_state = compute_state(raw_next, anomaly_score, cluster_distance)
                            max_q = np.max(self.policy.target_model.predict(np.array([next_state]), verbose=0)[0])
                            reward = estimate_reward(act, current_metrics, raw_next)
                            effectiveness_weight = eff_manager.get_effectiveness(act)
                            expected_value = (reward + self.policy.gamma * max_q) * effectiveness_weight
                            expected_values.append(expected_value)
                        action = ACTIONS[np.argmax(expected_values)]
        reasoning = {
            "anomaly_type": assessment["type"],
            "anomaly_score": assessment["anomaly_score"],
            "cluster_distance": assessment["cluster_distance"],
            "selected_action": action
        }
        self.action_history.append((time.time(), action, reasoning, None))
        return action

    def evaluate_response(self, action: str, reward: float, pre_metrics: np.ndarray, post_metrics: np.ndarray) -> Dict[str, Any]:
        anomaly_change = float(self.brain.predict(pre_metrics)[0] - self.brain.predict(post_metrics)[0])
        success = reward > 0 and anomaly_change > 0
        reasoning = {
            "action": action,
            "reward": reward,
            "anomaly_change": anomaly_change,
            "success": success,
            "next_step": "Reinforce strategy" if success else "Adjust strategy"
        }
        if self.action_history and self.action_history[-1][1] == action:
            timestamp, act, reason, _ = self.action_history[-1]
            if 'consciousness' in globals():
                reflection = consciousness.reflect(action, reward, pre_metrics, post_metrics)
                reasoning["reflection"] = reflection
            self.action_history[-1] = (timestamp, action, reason, reasoning)
        self.logger.log_event("INFO", f"Response Evaluation: {reasoning}")
        return reasoning

    def proactive_step(self, current_metrics: np.ndarray, predicted_metrics: np.ndarray) -> Optional[str]:
        current_score = self.brain.predict(current_metrics)[0]
        predicted_score = self.brain.predict(predicted_metrics, use_history=False)[0]
        if predicted_score > CONFIG.anomaly_threshold and predicted_score > current_score + 0.15:
            reasoning = f"Prediction: Anomaly score rises from {current_score:.2f} to {predicted_score:.2f}. Preemptive action needed."
            action = "Reinforce"
            self.logger.log_event("INFO", f"Proactive Step: {reasoning}")
            return action
        return None

# --- System Monitoring with HWS Integration ---
async def gather_metrics(hws_queue: queue.Queue) -> np.ndarray:
    try:
        cpu = psutil.cpu_percent(interval=0.1)
        mem = psutil.virtual_memory().percent
        disk = psutil.disk_usage("/").percent
        net_io = psutil.net_io_counters()
        disk_io = psutil.disk_io_counters() or psutil._common.sdiskio(0, 0, 0, 0, 0, 0)
        processes = len(psutil.pids())
        connections = len(psutil.net_connections())
        bad_connections = sum(1 for conn in psutil.net_connections() if conn.raddr and conn.raddr.ip in STATE.bad_ips)
        latency = random.uniform(0, 10)
        process_metrics = []
        for p in psutil.process_iter(["cpu_percent", "memory_percent"]):
            try:
                cpu_val = p.info["cpu_percent"] or 0.0
                mem_val = p.info["memory_percent"] or 0.0
                process_metrics.append((cpu_val, mem_val))
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                process_metrics.append((0.0, 0.0))
        max_cpu = max(pm[0] for pm in process_metrics) if process_metrics else 0.0
        max_mem = max(pm[1] for pm in process_metrics) if process_metrics else 0.0
        user_logins = len([conn for conn in psutil.net_connections() if conn.laddr.port == 22])

        # Integrate HWS data
        try:
            hws_data = hws_queue.get_nowait()
            num_persons = hws_data.get('num_persons', 0)
            num_weapons = hws_data.get('num_weapons', 0)
        except queue.Empty:
            num_persons = 0
            num_weapons = 0

        metrics = np.array([cpu, mem, disk, net_io.bytes_sent, net_io.bytes_recv, processes, connections,
                            bad_connections, max_cpu, max_mem, disk_io.read_bytes, latency, user_logins,
                            num_persons, num_weapons], dtype=np.float32)

        signature_detector = SignatureDetector("threat_signatures.json")
        detected_signatures = signature_detector.check_metrics(metrics)
        if detected_signatures:
            STATE.logger.log_event("WARNING", "Detected threat signatures", {"signatures": detected_signatures})
            await send_notification({"threat_signatures": detected_signatures})

        return metrics
    except Exception:
        if STATE.metrics_history:
            return np.array(list(STATE.metrics_history)[-1], dtype=np.float32)
        return np.zeros(15, dtype=np.float32)

