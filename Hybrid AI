        if hasattr(self, 'audio_stream'):
            self.audio_stream.stop()

    def audio_callback(self, indata, frames, time, status):
        audio = torch.from_numpy(indata).float().squeeze()
        with torch.no_grad():
            emission = self.audio_model(audio.unsqueeze(0))[0]
            probs = torch.softmax(emission.mean(dim=0), dim=-1)
            event_id = probs.argmax().item() % 4
            confidence = probs.max().item()
        event_labels = {0: "background", 1: "gunshot", 2: "scream", 3: "crash"}
        if event_id > 0 and confidence > 0.7:
            self.audio_events.append((datetime.now(), event_labels[event_id]))
            self.speak(f"{event_labels[event_id]} detected.")
            if confidence < 0.7:
                self.audio_samples.append((indata.copy(), event_id))

    def _speech_loop(self):
        while True:
            message = self.speech_queue.get()
            if message is None:
                break
            self.tts.say(message)
            self.tts.runAndWait()

    def speak(self, message):
        if message not in self.last_spoken or self.last_spoken[message] > 15:
            self.speech_queue.put(message)
            self.last_spoken[message] = 0
        for key in list(self.last_spoken.keys()):
            self.last_spoken[key] += 1
            if self.last_spoken[key] > 30:
                del self.last_spoken[key]

    def get_location(self, box, depth_map):
        x_center = (box[0] + box[2]) / 2
        depth = depth_map[int((box[1] + box[3]) / 2), int(x_center)]
        if x_center < self.frame_width / 3:
            return f"left (depth {depth:.2f}m)"
        elif x_center < 2 * self.frame_width / 3:
            return f"center (depth {depth:.2f}m)"
        return f"right (depth {depth:.2f}m)"

    def compute_iou(self, box1, box2):
        x1_min, y1_min, x1_max, y1_max = box1
        x2_min, y2_min, x2_max, y2_max = box2
        inter_area = max(0, min(x1_max, x2_max) - max(x1_min, x2_min)) * max(0, min(y1_max, y2_max) - max(y1_min, y2_min))
        box1_area = (x1_max - x1_min) * (y1_max - y1_min)
        box2_area = (x2_max - x2_min) * (y2_max - y2_min)
        return inter_area / (box1_area + box2_area - inter_area + 1e-6)

    def estimate_depth(self, frame):
        frame_tensor = torch.from_numpy(frame).permute(2, 0, 1).unsqueeze(0).float() / 255.0
        if torch.cuda.is_available():
            frame_tensor = frame_tensor.cuda()
        with torch.no_grad():
            depth = self.depth_estimator(frame_tensor)
            depth = F.interpolate(depth.unsqueeze(1), size=(self.frame_height, self.frame_width), mode='bicubic')
        return depth.squeeze().cpu().numpy()

    def compute_scene_vector(self, tracks, pose_results, audio_events, depth_map):
        histogram = np.zeros(len(self.class_list))
        for t in tracks:
            if t.is_confirmed():
                label = t.det_class
                idx = self.label_to_idx.get(label, len(self.class_list) - 1)
                histogram[idx] += 1
        people_tracks = [t for t in tracks if t.det_class == "person"]
        people_tracks.sort(key=lambda t: (t.to_tlbr()[2] - t.to_tlbr()[0]) * (t.to_tlbr()[3] - t.to_tlbr()[1]), reverse=True)
        pose_vectors = []
        for i in range(5):
            if i < len(people_tracks):
                track_box = people_tracks[i].to_tlbr()
                best_iou = 0
                best_pose = None
                pose_landmarks_list = pose_results.pose_landmarks if pose_results.pose_landmarks else []
                for pose_landmarks in pose_landmarks_list:
                    lm_x = [lm.x * self.frame_width for lm in pose_landmarks.landmark]
                    lm_y = [lm.y * self.frame_height for lm in pose_landmarks.landmark]
                    pose_box = [min(lm_x), min(lm_y), max(lm_x), max(lm_y)]
                    iou = self.compute_iou(pose_box, track_box)
                    if iou > best_iou:
                        best_iou = iou
                        best_pose = pose_landmarks
                if best_iou > 0.3 and best_pose:
                    landmarks = best_pose.landmark
                    pose_vec = np.array([[lm.x, lm.y, lm.z] for lm in landmarks if lm.visibility > 0.7]).flatten()
                    pose_vectors.append(pose_vec if len(pose_vec) == 99 else np.zeros(99))
                else:
                    pose_vectors.append(np.zeros(99))
            else:
                pose_vectors.append(np.zeros(99))
        pose_part = np.concatenate(pose_vectors)
        current_time = datetime.now()
        recent_events = [event for t, event in audio_events if (current_time - t).total_seconds() < 1]
        audio_vector = np.zeros(4)
        if recent_events:
            latest_event = recent_events[-1]
            event_idx = {"background": 0, "gunshot": 1, "scream": 2, "crash": 3}.get(latest_event, 0)
            audio_vector[event_idx] = 1
        depth_hist, _ = np.histogram(depth_map, bins=10, range=(0, 10))
        depth_hist = depth_hist / depth_hist.sum() if depth_hist.sum() > 0 else depth_hist
        return np.concatenate([histogram, pose_part, audio_vector, depth_hist])

    def detect_anomaly(self, scene_vector):
        scene_tensor = torch.from_numpy(scene_vector).float().unsqueeze(0)
        if torch.cuda.is_available():
            scene_tensor = scene_tensor.cuda()
        with torch.no_grad():
            recon, _ = self.scene_autoencoder(scene_tensor)
            mse = F.mse_loss(recon, scene_tensor)
        self.scene_history.append(mse.item())
        self.vae_optimizer.zero_grad()
        recon, _ = self.scene_autoencoder(scene_tensor)
        loss = F.mse_loss(recon, scene_tensor)
        loss.backward()
        self.vae_optimizer.step()
        if len(self.scene_history) > 10:
            mean_mse = np.mean(list(self.scene_history)[:-1])
            std_mse = np.std(list(self.scene_history)[:-1])
            if mse.item() > mean_mse + 3 * std_mse:
                self.anomaly_frames.append(scene_vector.copy())
                return True
        return False

