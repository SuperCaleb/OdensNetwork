# --- Positional Encoding Layer ---
class PositionalEncoding(layers.Layer):
    def __init__(self, position, d_model):
        super(PositionalEncoding, self).__init__()
        self.pos_encoding = self.positional_encoding(position, d_model)

    def get_angles(self, position, i, d_model):
        angles = 1 / np.power(10000, (2 * (i // 2)) / np.float32(d_model))
        return position * angles

    def positional_encoding(self, position, d_model):
        angle_rads = self.get_angles(
            np.arange(position)[:, np.newaxis],
            np.arange(d_model)[np.newaxis, :],
            d_model
        )
        angle_rads[:, 0::2] = np.sin(angle_rads[:, 0::2])
        angle_rads[:, 1::2] = np.cos(angle_rads[:, 1::2])
        pos_encoding = angle_rads[np.newaxis, ...]
        return tf.cast(pos_encoding, dtype=tf.float32)

    def call(self, inputs):
        return inputs + self.pos_encoding[:, :tf.shape(inputs)[1], :]

# --- Transformer Encoder Layer ---
class TransformerEncoderLayer(layers.Layer):
    def __init__(self, d_model, num_heads, ff_dim, dropout=0.1):
        super(TransformerEncoderLayer, self).__init__()
        self.mha = layers.MultiHeadAttention(num_heads=num_heads, key_dim=d_model // num_heads)
        self.ffn = Sequential([layers.Dense(ff_dim, activation="relu"), layers.Dense(d_model)])
        self.layernorm1 = layers.LayerNormalization(epsilon=1e-6)
        self.layernorm2 = layers.LayerNormalization(epsilon=1e-6)
        self.dropout1 = layers.Dropout(dropout)
        self.dropout2 = layers.Dropout(dropout)

    def call(self, x, training=None):
        attn_output = self.mha(x, x, x)
        attn_output = self.dropout1(attn_output, training=training)
        out1 = self.layernorm1(x + attn_output)
        ffn_output = self.ffn(out1)
        ffn_output = self.dropout2(ffn_output, training=training)
        return self.layernorm2(out1 + ffn_output)

# --- Enhanced Logging System with NLP ---
class OdenLogger:
    def __init__(self, config: OdenConfig):
        self.config = config
        self.logger = self._setup_logger()
        self.nlp = pipeline("sentiment-analysis", model="distilbert-base-uncased")
        self.log_metrics = {
            "info_count": 0, "warning_count": 0, "error_count": 0, "critical_count": 0, "last_alert_time": 0.0
        }
        self.lock = threading.Lock()
        self.alert_queue = deque(maxlen=100)

    def _setup_logger(self) -> logging.Logger:
        logger = logging.getLogger("Oden")
        logger.setLevel(logging.INFO)
        rfh = logging.handlers.RotatingFileHandler(
            filename=self.config.log_file,
            maxBytes=self.config.log_max_bytes,
            backupCount=self.config.log_backup_count
        )

        class StructuredFormatter(logging.Formatter):
            def format(self, record):
                log_dict = {
                    "timestamp": datetime.datetime.now().isoformat(),
                    "level": record.levelname,
                    "message": record.msg % (record.args if record.args else ()),
                    "module": record.module,
                    "line": record.lineno,
                    "process": record.process,
                    "thread": record.threadName,
                }
                if hasattr(record, 'extra'):
                    log_dict.update(record.extra)
                return json.dumps(log_dict)

        rfh.setFormatter(StructuredFormatter())
        logger.handlers.clear()
        logger.addHandler(rfh)
        ch = logging.StreamHandler(sys.stdout)
        ch.setFormatter(logging.Formatter("%(asctime)s - %(levelname)s - %(message)s", datefmt="%Y-%m-%d %H:%M:%S"))
        logger.addHandler(ch)
        return logger

    def log_event(self, level: str, message: str, extra: Dict[str, Any] = None):
        with self.lock:
            extra = extra or {}
            sentiment = self.nlp(message)[0]
            if sentiment["label"] == "NEGATIVE" and sentiment["score"] > 0.9:
                self.alert_queue.append((time.time(), "CRITICAL", f"Negative sentiment detected: {message}"))
            getattr(self.logger, level.lower())(message, extra=extra)
            self._update_metrics(level)
            self._check_alert_threshold(level, message)

    def _update_metrics(self, level: str):
        level_map = {"INFO": "info_count", "WARNING": "warning_count", "ERROR": "error_count", "CRITICAL": "critical_count"}
        if level in level_map:
            self.log_metrics[level_map[level]] += 1

    def _check_alert_threshold(self, level: str, message: str):
        current_time = time.time()
        if level in ("WARNING", "ERROR", "CRITICAL"):
            self.alert_queue.append((current_time, level, message))
            severe_count = sum(1 for _, lvl, _ in self.alert_queue if lvl in ("WARNING", "ERROR", "CRITICAL"))
            severe_recent = sum(1 for t, lvl, _ in self.alert_queue if lvl in ("WARNING", "ERROR", "CRITICAL") and current_time - t < 60)
            if severe_recent > 10:
                asyncio.create_task(self._send_log_alert(severe_recent, "High rate of severe logs detected"))
            if severe_count >= self.config.log_alert_threshold and current_time - self.log_metrics["last_alert_time"] > 3600:
                asyncio.create_task(self._send_log_alert(severe_count))
                self.log_metrics["last_alert_time"] = current_time

    async def _send_log_alert(self, count: int, extra_msg: str = ""):
        msg = f"High volume of logs: {count} warnings/errors. {extra_msg}"
        await send_notification({"log_alert": msg})

    async def report_metrics(self):
        while STATE.active:
            with self.lock:
                self.logger.info("Logging metrics report", extra={"metrics": self.log_metrics.copy(), "alert_queue_size": len(self.alert_queue)})
            await asyncio.sleep(self.config.log_metrics_interval)

