# --- Configuration ---
@dataclass
class OdenConfig:
    log_file: str = "oden_security.log"
    anomaly_threshold: float = None  # Set dynamically after training
    input_window: int = 4            # Past metrics for prediction
    metrics_history_size: int = 100  # History size for monitoring
    training_samples: int = 1000     # Initial training samples
    learning_rate: float = 0.0003
    check_interval: float = 1.0
    action_cooldown: float = 3.0
    retrain_interval: int = 100      # Retrain every 100 loops

CONFIG = OdenConfig()

# --- Logging Setup ---
logging.basicConfig(filename=CONFIG.log_file, level=logging.INFO,
                    format='%(asctime)s - %(message)s')

# --- Global State and Thread Management ---
class SystemState:
    def __init__(self):
        self.active = True
        self.bad_ips = {"1.2.3.4", "5.6.7.8"}  # Expandable bad IPs
        self.metrics_history = deque(maxlen=CONFIG.metrics_history_size)
        self.anomaly_history = deque(maxlen=CONFIG.metrics_history_size)
        self.new_metrics_buffer = deque(maxlen=CONFIG.retrain_interval * 2)
        self.last_action_time = 0.0
        self.last_spawn_time = 0.0
        self.spawn_cooldown = 60.0  # Seconds
        self.emotion = "calm"       # Emotional state for Damasio's Theory

STATE = SystemState()
ACTIONS = ["Terminate", "Block", "Investigate", "Isolate Network", "Alert Administrator"]
CRITICAL_PROCESSES = {"python3", "systemd", "bash", "sshd"}
SCALER = StandardScaler()
ACTIVE_THREADS = []
THREAD_LOCK = threading.Lock()
MAX_THREADS = 4
RETRAIN_LOCK = threading.Lock()

# --- Transformer-Based Predictor ---
def positional_encoding(position, d_model):
    """Generates positional encodings for the Transformer."""
    angle_rads = np.arange(position)[:, np.newaxis] * \
                 (1 / np.power(10000, (2 * (np.arange(d_model) // 2)) / np.float32(d_model)))
    angle_rads[:, 0::2] = np.sin(angle_rads[:, 0::2])
    angle_rads[:, 1::2] = np.cos(angle_rads[:, 1::2])
    return tf.cast(angle_rads[np.newaxis, ...], dtype=tf.float32)

class EncoderLayer(Model):
    """Single Transformer encoder layer."""
    def __init__(self, d_model, num_heads, dff):
        super(EncoderLayer, self).__init__()
        self.mha = layers.MultiHeadAttention(num_heads=num_heads, key_dim=d_model // num_heads)
        self.ffn = tf.keras.Sequential([
            layers.Dense(dff, activation='relu'),
            layers.Dense(d_model)
        ])
        self.layernorm1 = layers.LayerNormalization(epsilon=1e-6)
        self.layernorm2 = layers.LayerNormalization(epsilon=1e-6)
        self.dropout1 = layers.Dropout(0.1)
        self.dropout2 = layers.Dropout(0.1)

    def call(self, x, training):
        attn_output = self.mha(x, x, x)
        attn_output = self.dropout1(attn_output, training=training)
        out1 = self.layernorm1(x + attn_output)
        ffn_output = self.ffn(out1)
        ffn_output = self.dropout2(ffn_output, training=training)
        out2 = self.layernorm2(out1 + ffn_output)
        return out2

class TransformerEncoder(Model):
    """Transformer encoder with multiple layers."""
    def __init__(self, num_layers, d_model, num_heads, dff, input_window):
        super(TransformerEncoder, self).__init__()
        self.d_model = d_model
        self.num_layers = num_layers
        self.embedding = layers.Dense(d_model)
        self.pos_encoding = positional_encoding(input_window, d_model)
        self.enc_layers = [EncoderLayer(d_model, num_heads, dff) for _ in range(num_layers)]
        self.dropout = layers.Dropout(0.1)

    def call(self, x, training):
        seq_len = tf.shape(x)[1]
        x = self.embedding(x)
        x *= tf.math.sqrt(tf.cast(self.d_model, tf.float32))
        x += self.pos_encoding[:, :seq_len, :]
        x = self.dropout(x, training=training)
        for i in range(self.num_layers):
            x = self.enc_layers[i](x, training=training)
        return x

class TransformerPredictor(Model):
    """Transformer model for predicting next system metrics."""
    def __init__(self, num_layers, d_model, num_heads, dff, input_window, output_dim):
        super(TransformerPredictor, self).__init__()
        self.encoder = TransformerEncoder(num_layers, d_model, num_heads, dff, input_window)
        self.dense = layers.Dense(output_dim)

    def call(self, inputs, training):
        x = self.encoder(inputs, training=training)
        return self.dense(x[:, -1, :])

class OdenBrain:
    def __init__(self):
        self.model = self._build_model()
        self.scaler = SCALER
        self.scaler_fitted = False

    def _build_model(self):
        num_layers = 2
        d_model = 64
        num_heads = 4
        dff = 128
        model = TransformerPredictor(num_layers, d_model, num_heads, dff,
                                   CONFIG.input_window, output_dim=6)
        model.compile(optimizer=tf.keras.optimizers.Adam(learning_rate=CONFIG.learning_rate),
                      loss="mse")
        return model

    def predict(self):
        """Computes anomaly score based on prediction error."""
        if len(STATE.metrics_history) < CONFIG.input_window + 1:
            return 0.0
        history = list(STATE.metrics_history)
        past_metrics = np.array(history[-CONFIG.input_window-1:-1])
        current_metrics = np.array(history[-1])
        if self.scaler_fitted:
            past_normalized = self.scaler.transform(past_metrics).astype(np.float16)
            current_normalized = self.scaler.transform(current_metrics[None, :])[0].astype(np.float16)
        else:
            past_normalized = past_metrics.astype(np.float16)
            current_normalized = current_metrics.astype(np.float16)
        input_tensor = tf.convert_to_tensor(past_normalized[None, :], dtype=tf.float16)
        predicted = self.model(input_tensor, training=False)[0]
        mse = tf.reduce_mean(tf.square(predicted - current_normalized)).numpy()
        return mse

# --- Enhanced DQN-Based Action Policy ---
class QNetwork(Model):
    """Complex-valued Q-network for Holonomic Brain Theory and Orch OR Theory."""
    def __init__(self, num_actions):
        super(QNetwork, self).__init__()
        self.dense1 = layers.Dense(64, activation=tf.math.abs, dtype='complex64')
        self.dense2 = layers.Dense(64, activation=tf.math.abs, dtype='complex64')
        self.q_values = layers.Dense(num_actions, dtype='complex64')

    def call(self, state):
        state_complex = tf.cast(state, tf.complex64)
        x = self.dense1(state_complex)
        x = self.dense2(x)
        q_values_complex = self.q_values(x)
        return tf.math.real(q_values_complex)  # Real Q-values for action selection

class PrioritizedReplayBuffer:
    """Prioritized replay buffer for Orch OR Theory-inspired memory focus."""
    def __init__(self, capacity, alpha=0.6):
        self.capacity = capacity
        self.alpha = alpha
        self.buffer = []
        self.priorities = []
        self.pos = 0

    def add(self, experience, priority):
        priority = max(priority, 1e-6)  # Ensure non-zero priority
        if len(self.buffer) < self.capacity:
            self.buffer.append(experience)
            self.priorities.append(priority)
        else:
            self.buffer[self.pos] = experience
            self.priorities[self.pos] = priority
        self.pos = (self.pos + 1) % self.capacity

    def sample(self, batch_size):
        if len(self.buffer) == 0:
            return []
        priorities = np.array(self.priorities)
        probs = priorities ** self.alpha
        probs /= probs.sum()
        indices = np.random.choice(len(self.buffer), min(batch_size, len(self.buffer)), p=probs)
        experiences = [self.buffer[idx] for idx in indices]
        return experiences

    def size(self):
        return len(self.buffer)

class OdenPolicy:
    def __init__(self, state_dim=7, num_actions=len(ACTIONS), buffer_capacity=10000,
                 batch_size=32, gamma=0.99):
        self.q_network = QNetwork(num_actions)
        self.target_network = QNetwork(num_actions)
        self.target_network.set_weights(self.q_network.get_weights())
        self.optimizer = tf.keras.optimizers.Adam(learning_rate=0.001)
        self.replay_buffer = PrioritizedReplayBuffer(buffer_capacity)
        self.batch_size = batch_size
        self.gamma = gamma
        self.num_actions = num_actions
        self.state_dim = state_dim
        self.lock = threading.Lock()

    def choose_action(self, state):
        """Emotion-driven action selection for Damasio's Theory."""
        epsilon = 1.0 if STATE.emotion == "calm" else 0.5 if STATE.emotion == "alert" else 0.1
        if random.random() < epsilon:
            return random.randint(0, self.num_actions - 1)
        state_tensor = tf.convert_to_tensor(state[None, :], dtype=tf.float32)
        q_values = self.q_network(state_tensor)
        return tf.argmax(q_values[0]).numpy()

    def train(self):
        """Trains the Q-network using prioritized experiences."""
        with self.lock:
            if self.replay_buffer.size() < self.batch_size:
                return
            experiences = self.replay_buffer.sample(self.batch_size)
            if not experiences:
                return
            states, actions, rewards, next_states, dones = zip(*experiences)
            states = np.array(states, dtype=np.float32)
            next_states = np.array(next_states, dtype=np.float32)
            rewards = np.array(rewards, dtype=np.float32)
            dones = np.array(dones, dtype=np.int32)
            actions = np.array(actions, dtype=np.int32)

            with tf.GradientTape() as tape:
                q_values = self.q_network(states)
                q_values_next = self.target_network(next_states)
                max_q_next = tf.reduce_max(q_values_next, axis=1)
                targets = rewards + self.gamma * max_q_next * (1 - dones)
                q_values_actions = tf.gather(q_values, actions, axis=1, batch_dims=1)
                loss = tf.keras.losses.MSE(targets, q_values_actions)

            grads = tape.gradient(loss, self.q_network.trainable_variables)
            self.optimizer.apply_gradients(zip(grads, self.q_network.trainable_variables))

    def update_target_network(self):
        """Syncs target network with Q-network."""
        self.target_network.set_weights(self.q_network.get_weights())

# --- System Metrics Collection ---
def gather_metrics():
    """Collects real-time system metrics."""
    try:
        cpu = psutil.cpu_percent(interval=0.1)
        mem = psutil.virtual_memory().percent
        disk = psutil.disk_usage("/").percent
        processes = len(psutil.pids())
        connections = len(psutil.net_connections())
        bad_connections = sum(1 for conn in psutil.net_connections()
                            if conn.raddr and conn.raddr.ip in STATE.bad_ips)
        return np.array([cpu, mem, disk, processes, connections, bad_connections],
                        dtype=np.float16)
    except Exception as e:
        logging.error(f"Metrics gathering failed: {str(e)}")
        return np.zeros(6, dtype=np.float16)

def metrics_collector():
    """Dedicated thread for collecting and updating metrics."""
    while STATE.active:
        metrics = gather_metrics()
        with threading.Lock():
            STATE.metrics_history.append(metrics)
            STATE.new_metrics_buffer.append(metrics)
        time.sleep(CONFIG.check_interval / 4)

# --- Training Data Processing ---
def collect_training_data(num_samples):
    """Collects initial training data."""
    training_metrics = []
    print("Collecting training data...")
    while len(training_metrics) < num_samples:
        metrics = gather_metrics()
        training_metrics.append(metrics)
        time.sleep(CONFIG.check_interval)
    return np.array(training_metrics)

def create_prediction_data(metrics, input_window):
    """Creates input-output pairs for Transformer training."""
    X = []
    y = []
    for i in range(len(metrics) - input_window):
        X.append(metrics[i:i + input_window])
        y.append(metrics[i + input_window])
    return np.array(X), np.array(y)

# --- Action Execution ---
def execute_action(action):
    """Executes system-level actions."""
    current_time = time.time()
    if current_time - STATE.last_action_time < CONFIG.action_cooldown:
        return
    STATE.last_action_time = current_time

    try:
        if action == "Terminate":
            target = max([p for p in psutil.process_iter(["pid", "cpu_percent", "name"])
                         if p.info["name"].lower() not in CRITICAL_PROCESSES
                         and p.info["cpu_percent"] is not None and p.info["cpu_percent"] > 50],
                         key=lambda p: p.info["cpu_percent"], default=None)
            if target:
                psutil.Process(target.info["pid"]).terminate()
                logging.info(f"Terminated process: {target.info['name']} (PID: {target.info['pid']})")
        elif action == "Block":
            bad_connections = [conn for conn in psutil.net_connections()
                              if conn.raddr and conn.raddr.ip in STATE.bad_ips]
            for conn in bad_connections:
                if conn.pid:
                    p = psutil.Process(conn.pid)
                    if p.name().lower() not in CRITICAL_PROCESSES:
                        p.terminate()
                        logging.info(f"Blocked process {p.name()} (PID: {p.pid})")
        elif action == "Investigate":
            logging.info("Investigating anomaly")
        elif action == "Isolate Network":
            subprocess.run(["iptables", "-P", "INPUT", "DROP"], check=True)
            subprocess.run(["iptables", "-A", "INPUT", "-p", "tcp", "--dport", "22", "-j", "ACCEPT"], check=True)
            logging.info("Network isolated: SSH only")
        elif action == "Alert Administrator":
            logging.critical("Critical anomaly detected!")
    except Exception as e:
        logging.error(f"Action '{action}' failed: {str(e)}")

# --- Core Detection and Learning Logic ---
def oden_core(brain, policy):
    """Main loop with anomaly detection, action selection, and online learning."""
    consecutive_normal = 0
    max_consecutive_normal = 10
    loop_count = 0
    previous_state = None
    previous_action = None
    while STATE.active:
        while len(STATE.metrics_history) < CONFIG.input_window + 1:
            time.sleep(0.1)
            if not STATE.active:
                return

        with threading.Lock():
            history = list(STATE.metrics_history)
        past_metrics = np.array(history[-CONFIG.input_window-1:-1])
        current_metrics = np.array(history[-1])
        if brain.scaler_fitted:
            past_normalized = brain.scaler.transform(past_metrics).astype(np.float16)
            current_normalized = brain.scaler.transform(current_metrics[None, :])[0].astype(np.float16)
        else:
            past_normalized = past_metrics.astype(np.float16)
            current_normalized = current_metrics.astype(np.float16)
        input_tensor = tf.convert_to_tensor(past_normalized[None, :], dtype=tf.float16)
        predicted = brain.model(input_tensor, training=False)[0]
        anomaly_score = tf.reduce_mean(tf.square(predicted - current_normalized)).numpy()
        STATE.anomaly_history.append(anomaly_score)

        # Update emotional state based on anomaly score (Damasio's Theory)
        with threading.Lock():
            if anomaly_score < CONFIG.anomaly_threshold:
                STATE.emotion = "calm"
            elif anomaly_score < 2 * CONFIG.anomaly_threshold:
                STATE.emotion = "alert"
            else:
                STATE.emotion = "fear"

        current_state = np.concatenate([current_metrics, [anomaly_score]])

        # Reinforcement Learning Step with Prioritized Replay (Orch OR Theory)
        if previous_state is not None:
            reward = -anomaly_score
            policy.replay_buffer.add((previous_state, previous_action, reward, current_state, 0),
                                    priority=anomaly_score)
            with policy.lock:
                if policy.replay_buffer.size() > policy.batch_size:
                    policy.train()
            if loop_count % 100 == 0:
                policy.update_target_network()

        action_index = policy.choose_action(current_state)
        action = ACTIONS[action_index]
        execute_action(action)

        # Self-Replication Logic
        if anomaly_score > 2 * CONFIG.anomaly_threshold:
            current_time = time.time()
            if current_time - STATE.last_spawn_time > STATE.spawn_cooldown:
                with THREAD_LOCK:
                    if len(ACTIVE_THREADS) < MAX_THREADS:
                        new_thread = threading.Thread(target=oden_core, args=(brain, policy), daemon=False)
                        new_thread.start()
                        ACTIVE_THREADS.append(new_thread)
                        STATE.last_spawn_time = current_time
                        logging.info(f"Spawned new thread, total threads: {len(ACTIVE_THREADS)}")

        # Online Learning for Transformer
        if loop_count % CONFIG.retrain_interval == 0:
            with threading.Lock():
                if len(STATE.new_metrics_buffer) >= CONFIG.input_window + 1:
                    new_metrics = np.array(STATE.new_metrics_buffer)
                    X_new, y_new = create_prediction_data(new_metrics, CONFIG.input_window)
                    if brain.scaler_fitted:
                        X_new_flat = X_new.reshape(-1, 6)
                        X_new_norm = brain.scaler.transform(X_new_flat).reshape(X_new.shape)
                        y_new_norm = brain.scaler.transform(y_new)
                    else:
                        X_new_norm = X_new
                        y_new_norm = y_new
                    with RETRAIN_LOCK:
                        brain.model.fit(X_new_norm, y_new_norm, epochs=1, batch_size=32, verbose=0)
                    print(f"Model retrained at loop {loop_count}")

        logging.info(f"Action: {action}, Anomaly: {anomaly_score:.4f}, "
                    f"Emotion: {STATE.emotion}, CPU: {current_metrics[0]:.1f}%, Mem: {current_metrics[1]:.1f}%")

        # Thread Termination Logic
        if anomaly_score < CONFIG.anomaly_threshold:
            consecutive_normal += 1
        else:
            consecutive_normal = 0
        if consecutive_normal >= max_consecutive_normal:
            break

        previous_state = current_state
        previous_action = action_index
        loop_count += 1
        time.sleep(CONFIG.check_interval)

    with THREAD_LOCK:
        ACTIVE_THREADS.remove(threading.current_thread())
    logging.info("Thread exiting due to low anomaly score")

# --- Signal Handler ---
def signal_handler(sig, frame):
    STATE.active = False
    print("Shutting down Oden...")

# --- Main Execution ---
if __name__ == "__main__":
    brain = OdenBrain()
    policy = OdenPolicy(state_dim=7, num_actions=len(ACTIONS))

    # Initial Training
    training_metrics = collect_training_data(CONFIG.training_samples)
    X_train, y_train = create_prediction_data(training_metrics, CONFIG.input_window)
    X_train_flat = X_train.reshape(-1, 6)
    brain.scaler.fit(X_train_flat)
    brain.scaler_fitted = True
    X_train_norm = brain.scaler.transform(X_train_flat).reshape(X_train.shape)
    y_train_norm = brain.scaler.transform(y_train)
    print("Training Transformer model...")
    brain.model.fit(X_train_norm, y_train_norm, epochs=10, batch_size=32, verbose=0)
    predicted_train = brain.model.predict(X_train_norm, verbose=0)
    mse_train = np.mean(np.square(predicted_train - y_train_norm), axis=1)
    CONFIG.anomaly_threshold = np.percentile(mse_train, 95)
    print(f"Anomaly threshold: {CONFIG.anomaly_threshold:.4f}")

    # Start Metrics Collector
    metrics_thread = threading.Thread(target=metrics_collector, daemon=False)
    metrics_thread.start()

    # Start Initial Oden Core Thread
    initial_thread = threading.Thread(target=oden_core, args=(brain, policy), daemon=False)
    initial_thread.start()
    with THREAD_LOCK:
        ACTIVE_THREADS.append(initial_thread)

    # Signal Handling
    signal.signal(signal.SIGINT, signal_handler)
    signal.signal(signal.SIGTERM, signal_handler)

    # Main Loop and Shutdown
    while STATE.active:
        time.sleep(1)

    # Wait for Threads to Finish
    for thread in ACTIVE_THREADS[:]:
        thread.join()
    metrics_thread.join()
