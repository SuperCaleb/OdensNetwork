import subprocess
import time
import random
from collections import deque, defaultdict
import logging

# Set up logging
logger = logging.getLogger("Oden")
logger.setLevel(logging.INFO)
file_handler = logging.FileHandler("oden.log")
file_handler.setFormatter(logging.Formatter("%(asctime)s - %(levelname)s - %(message)s"))
console_handler = logging.StreamHandler()
console_handler.setFormatter(logging.Formatter("%(asctime)s - %(levelname)s - %(message)s"))
logger.addHandler(file_handler)
logger.addHandler(console_handler)

# Constants
HISTORY_SIZE = 100
MIN_HISTORY = 10
STD_MULTIPLIER = 2
ALPHA = 0.1  # Learning rate
GAMMA = 0.9  # Discount factor
EPSILON_INITIAL = 1.0
EPSILON_DECAY = 0.995
EPSILON_MIN = 0.1
ACTIONS = ["Monitor", "Investigate", "Terminate", "Reinforce"]

def gather_metrics():
    """Gather system metrics (CPU, memory, disk usage) using system commands."""
    try:
        cpu = float(subprocess.check_output("top -bn1 | grep 'Cpu(s)' | awk '{print $2 + $4}'", shell=True).decode().strip())
        mem = float(subprocess.check_output("free | grep Mem | awk '{print ($3/$2)*100}'", shell=True).decode().strip())
        disk = float(subprocess.check_output("df / | tail -1 | awk '{print $5}' | sed 's/%//'", shell=True).decode().strip())
        return [cpu, mem, disk]
    except Exception as e:
        logger.error(f"Failed to gather metrics: {e}")
        return [0, 0, 0]

def compute_state(metrics):
    """Convert metrics into a discrete state for RL policy."""
    cpu_bin = min(int(metrics[0] // 20), 4)  # Bins: [0-20], [20-40], [40-60], [60-80], [80-100]
    mem_bin = min(int(metrics[1] // 20), 4)
    disk_bin = min(int(metrics[2] // 20), 4)
    return (cpu_bin, mem_bin, disk_bin)

def compute_stats(history):
    """Calculate mean and standard deviation of historical metrics."""
    if not history:
        return [0, 0, 0], [1, 1, 1]  # Avoid division by zero
    n = len(history)
    sums = [0, 0, 0]
    for metrics in history:
        for i in range(3):
            sums[i] += metrics[i]
    means = [s / n for s in sums]
    variances = [0, 0, 0]
    for metrics in history:
        for i in range(3):
            variances[i] += (metrics[i] - means[i]) ** 2
    stds = [(v / n) ** 0.5 for v in variances]
    return means, stds

def execute_action(action, metrics):
    """Execute the chosen action (simplified to logging for dependency-free operation)."""
    if action == "Monitor":
        pass
    elif action == "Investigate":
        logger.info(f"Investigating: CPU={metrics[0]:.1f}%, Mem={metrics[1]:.1f}%, Disk={metrics[2]:.1f}%")
    elif action == "Terminate":
        logger.info("Terminating high CPU process")
    elif action == "Reinforce":
        logger.info("Reinforcing system defenses")

def main():
    """Main loop for monitoring, anomaly detection, and action execution."""
    history = deque(maxlen=HISTORY_SIZE)
    q_table = defaultdict(lambda: {a: 0 for a in ACTIONS})
    epsilon = EPSILON_INITIAL

    while True:
        current = gather_metrics()
        if len(history) >= MIN_HISTORY:
            means, stds = compute_stats(history)
            anomalies = [current[i] > means[i] + STD_MULTIPLIER * stds[i] for i in range(3)]
            anomalous_metrics = sum(anomalies)
            state = compute_state(current)

            # Choose action using epsilon-greedy policy
            if random.random() < epsilon:
                action = random.choice(ACTIONS)
            else:
                q_values = q_table[state]
                action = max(q_values, key=q_values.get)
            logger.info(f"Chose action: {action}")

            # Execute action
            execute_action(action, current)
            time.sleep(1)  # Wait to observe effect

            # Gather new metrics and compute reward
            new_metrics = gather_metrics()
            new_anomalies = sum([new_metrics[i] > means[i] + STD_MULTIPLIER * stds[i] for i in range(3)])
            if action == "Monitor":
                reward = 0.1 if anomalous_metrics == 0 else -0.5
            else:
                reward = anomalous_metrics - new_anomalies  # Positive if anomalies decrease

            # Update Q-table
            new_state = compute_state(new_metrics)
            q_current = q_table[state][action]
            q_next_max = max(q_table[new_state].values())
            q_new = q_current + ALPHA * (reward + GAMMA * q_next_max - q_current)
            q_table[state][action] = q_new

            # Decay epsilon
            epsilon = max(EPSILON_MIN, epsilon * EPSILON_DECAY)
        history.append(current)

if __name__ == "__main__":
    main()
